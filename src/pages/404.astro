---
import BaseHead from "@/components/BaseHead.astro";
import PixelSprite from "@/components/PixelSprite.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/global.css";

const navItems = [
  { label: "Projects", href: "/#projects" },
  { label: "Contact", href: "/#contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="404 · Johannes Grof" description="This page has moved or doesn’t exist." canonicalPath="/404" noindex />
    <script is:inline>
      document.documentElement.lang = window.location.pathname.startsWith("/de/") ? "de" : "en";
    </script>
  </head>
  <body class="error-page">
    <SiteHeader navItems={navItems} ariaLabel="Site navigation" homeHref="/" lang="en" />
    <main id="main" class="notfound section-shell">
      <div class="notfound-topline">
        <p class="eyebrow"><span data-error-lang="en">404 / page not found</span><span data-error-lang="de">404 / Seite nicht gefunden</span></p>
        <div class="error-language" role="group" aria-label="Language / Sprache">
          <button type="button" data-error-language="en" aria-pressed="true">EN</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-error-language="de" aria-pressed="false">DE</button>
        </div>
      </div>

      {/* A departure board: the requested page is a cancelled train, home and
          the catalogue are the replacement service. */}
      <section class="led-board" aria-labelledby="board-title">
        <div class="led-top">
          <span id="board-title">johannesgrof.me</span>
          <span data-error-clock>--:--</span>
        </div>
        <ul class="led-rows">
          <li class="led-row">
            <span class="led-line">404</span>
            <span class="led-dest"><span data-notfound-path>/404</span><small><span data-error-lang="en">This page</span><span data-error-lang="de">Diese Seite</span></small></span>
            <span class="led-eta led-eta--cancelled"><span data-error-lang="en">cancelled</span><span data-error-lang="de">fällt aus</span></span>
          </li>
          <li class="led-row">
            <a href="/" data-error-home>
              <span class="led-line">S1</span>
              <span class="led-dest"><span data-error-lang="en">Home</span><span data-error-lang="de">Startseite</span><small><span data-error-lang="en">Replacement service</span><span data-error-lang="de">Ersatzverkehr</span></small></span>
              <span class="led-eta"><span data-error-lang="en">now</span><span data-error-lang="de">jetzt</span></span>
            </a>
          </li>
          <li class="led-row">
            <a href="/projects/" data-error-projects>
              <span class="led-line">S2</span>
              <span class="led-dest"><span data-error-lang="en">All projects</span><span data-error-lang="de">Alle Projekte</span><small><span data-error-lang="en">Replacement service</span><span data-error-lang="de">Ersatzverkehr</span></small></span>
              <span class="led-eta"><span data-error-lang="en">now</span><span data-error-lang="de">jetzt</span></span>
            </a>
          </li>
        </ul>
        <div class="led-ticker" aria-hidden="true">
          <span>
            <span data-error-lang="en">Reason: the page has moved or was never built. We apologise for the inconvenience.</span>
            <span data-error-lang="de">Grund: Die Seite wurde verschoben oder nie gebaut. Wir bitten um Ihr Verständnis.</span>
          </span>
        </div>
      </section>

      <div class="notfound-track" aria-hidden="true">
        <span class="notfound-train"><PixelSprite name="train" /></span>
        <span class="notfound-buffer"><PixelSprite name="buffer" /></span>
      </div>

      <div data-error-lang="en" lang="en">
        <h1>This train is cancelled.</h1>
        <p class="notfound-text">The page you asked for has moved or doesn’t exist. The replacement service above gets you back.</p>
      </div>
      <div data-error-lang="de" lang="de">
        <h1>Dieser Zug fällt aus.</h1>
        <p class="notfound-text">Die Seite gibt es nicht (mehr). Der Ersatzverkehr oben bringt dich zurück.</p>
      </div>
      <noscript><p class="notfound-text" lang="de">Hier sollte etwas sein. Die Seite wurde verschoben oder existiert nicht. <a href="/de/">Zur deutschen Startseite</a></p></noscript>
    </main>
    <SiteFooter lang="en" />
    <script>
      import "@/scripts/notfound";
    </script>
  </body>
</html>

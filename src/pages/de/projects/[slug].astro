---
import DesktopPage from "@/layouts/DesktopPage.astro";
import { siteContentByLocale } from "@/data/siteContent";
import { publicProjects } from "@/data/projects";

export async function getStaticPaths() {
  return publicProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<DesktopPage content={siteContentByLocale.de} canonicalPath={`/de/projects/${project.slug}/`} initialProject={project.slug} />

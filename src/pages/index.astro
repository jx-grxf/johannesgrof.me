---
import { featuredProjects, upcomingProjects } from "@/data/projects";
import { siteContent } from "@/data/siteContent";
import "@/styles/global.css";

const navItems = [
  { label: "Projects", href: "#projects" },
  { label: "Services", href: "#services" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
];

const statusClass = (status: string) => status.replaceAll(" ", "-");

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={siteContent.metaDescription}
    />
    <title>Johannes Grof</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Johannes Grof home">
        <span class="brand-mark">jg</span>
        <span>Johannes Grof</span>
      </a>
      <nav aria-label="Primary navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main>
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">{siteContent.hero.eyebrow}</p>
          <h1 id="hero-title">{siteContent.hero.title}</h1>
          <p class="hero-text">{siteContent.hero.body}</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">{siteContent.hero.primaryAction}</a>
            <a class="button secondary" href="#services">{siteContent.hero.secondaryAction}</a>
            <a class="button secondary icon-button" href="https://github.com/jx-grxf" target="_blank" rel="noreferrer" aria-label="Johannes Grof on GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.95c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.95.68 1.92v2.85c0 .27.18.59.69.49A10.05 10.05 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"
                />
              </svg>
              {siteContent.hero.githubAction}
            </a>
          </div>
        </div>

        <aside class="terminal-card" aria-label="Developer profile tree">
          <div class="terminal-bar">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <pre><code><span class="path">/home/johannes_grof/</span>
├─ <span class="folder">my_links/</span>
│  ├─ <span class="link">github</span>
│  └─ <span class="link">linkedin</span>
├─ <span class="folder">projects/</span>
│  ├─ OpenClaw-Discord-Voice
│  ├─ DocxToPDF
│  ├─ Caruso-Reborn
│  ├─ PatchPilot
│  ├─ Digi2PDF
│  └─ SlamX
│     └─ <span class="folder">coming-soon/</span>
│        ├─ TypeBot
│        └─ StackBar
├─ <span class="folder">services/</span>
│  └─ coming-soon
└─ <span class="folder">contact/</span>
   └─ jx_grxf</code></pre>
        </aside>
      </section>

      <section id="projects" class="section-shell">
        <div class="section-heading">
          <p class="eyebrow">selected work</p>
          <h2>Projects</h2>
        </div>
        <div class="project-grid">
          {
            featuredProjects.map((project) =>
              project.href ? (
                <a class="project-card" href={project.href} target="_blank" rel="noreferrer">
                  <div class="card-topline">
                    <h3>{project.name}</h3>
                    <span class={`status ${statusClass(project.status)}`}>{project.status}</span>
                  </div>
                  <p>{project.description}</p>
                  <ul>
                    {project.stack.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </a>
              ) : (
                <article class="project-card private-card">
                  <div class="card-topline">
                    <h3>{project.name}</h3>
                    <span class={`status ${statusClass(project.status)}`}>{project.status}</span>
                  </div>
                  <p>{project.description}</p>
                  <ul>
                    {project.stack.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              )
            )
          }
        </div>
        <div class="coming-soon-group" aria-labelledby="coming-soon-title">
          <h3 id="coming-soon-title">coming soon</h3>
          <div class="upcoming-list">
            {
              upcomingProjects.map((project) => (
                <article class="upcoming-project">
                  <div>
                    <h4>{project.name}</h4>
                    <p>{project.description}</p>
                  </div>
                  <span class={`status ${statusClass(project.status)}`}>{project.status}</span>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="services" class="services-band">
        <div class="section-shell services-layout">
          <div>
            <p class="eyebrow">{siteContent.services.eyebrow}</p>
            <h2>{siteContent.services.title}</h2>
          </div>
          <ul class="service-list">
            {siteContent.services.items.map((service) => <li>{service}</li>)}
          </ul>
        </div>
      </section>

      <section id="about" class="section-shell split-section">
        <div>
          <p class="eyebrow">{siteContent.about.eyebrow}</p>
          <h2>{siteContent.about.title}</h2>
        </div>
        <p>{siteContent.about.body}</p>
      </section>

      <section id="contact" class="section-shell contact-section">
        <div>
          <p class="eyebrow">{siteContent.contact.eyebrow}</p>
          <h2>{siteContent.contact.title}</h2>
        </div>
        <div class="contact-links">
          <a href="https://github.com/jx-grxf" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://at.linkedin.com/in/johannes-grof-246892379" target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </section>
    </main>
  </body>
</html>

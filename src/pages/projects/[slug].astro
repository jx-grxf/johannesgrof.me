---
import SpeedInsights from "@vercel/speed-insights/astro";
import type { ProjectReleaseDownload } from "@/data/github";
import { getProjectGitHubInfo } from "@/data/github";
import { featuredProjects, statusClass } from "@/data/projects";
import "@/styles/global.css";

export async function getStaticPaths() {
  return featuredProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const github = await getProjectGitHubInfo(project);
const [heroImage, ...galleryImages] = project.showcase;
const downloads = [github.downloadGroup?.stable, ...(github.downloadGroup?.prereleases ?? [])].filter(
  (download): download is ProjectReleaseDownload => Boolean(download)
);
const hasMultipleDownloads = downloads.length > 1;
const downloadMenuId = `${project.slug}-download-menu`;

const formatDate = (date: string) => {
  if (!date) {
    return "recent";
  }

  return new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(date));
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${project.name}: ${project.tagline}`} />
    <title>{project.name} · Johannes Grof</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Johannes Grof home">
        <span class="brand-mark">jg</span>
        <span>Johannes Grof</span>
      </a>
      <nav aria-label="Project navigation">
        <a href="/#projects">Projects</a>
        <a href={project.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={github.releaseUrl} target="_blank" rel="noreferrer">Release</a>
      </nav>
    </header>

    <main class="project-detail section-shell">
      <a class="back-link" href="/#projects">Back to projects</a>

      <section class="project-detail-hero" aria-labelledby="project-title">
        <div class="project-detail-copy">
          <div class="project-kicker">
            <span class={`status ${statusClass(project.status)}`}>{project.status}</span>
            <span>{github.version}</span>
          </div>
          <h1 id="project-title">{project.name}</h1>
          <p class="project-tagline">{project.tagline}</p>
          <p class="project-description">{project.description}</p>
          <div class="project-actions">
            {github.downloadGroup && (
              hasMultipleDownloads ? (
                <div class="download-menu" data-download-menu>
                  <button
                    class={`button download-button ${github.downloadGroup.stable?.kind ?? github.downloadGroup.prereleases[0]?.kind ?? "release"}`}
                    type="button"
                    aria-expanded="false"
                    aria-controls={downloadMenuId}
                    data-download-trigger
                  >
                    <span>Download</span>
                    <small>Choose release asset</small>
                  </button>
                  <div id={downloadMenuId} class="download-options" aria-hidden="true" data-download-options>
                    {github.downloadGroup.stable && (
                      <a href={github.downloadGroup.stable.assetUrl} target="_blank" rel="noreferrer">
                        <span class="download-option-meta">Stable</span>
                        <strong>{github.downloadGroup.stable.tag}</strong>
                        <span>{github.downloadGroup.stable.label} · {github.downloadGroup.stable.detail}</span>
                      </a>
                    )}
                    {github.downloadGroup.prereleases.map((download) => (
                      <a href={download.assetUrl} target="_blank" rel="noreferrer">
                        <span class="download-option-meta">Pre-release</span>
                        <strong>{download.tag}</strong>
                        <span>{download.label} · {download.detail}</span>
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a class={`button download-button ${downloads[0]?.kind ?? "release"}`} href={downloads[0]?.assetUrl} target="_blank" rel="noreferrer">
                  <span>{downloads[0]?.label}</span>
                  <small>{downloads[0]?.detail}</small>
                </a>
              )
            )}
            <a class="button secondary" href={project.githubUrl} target="_blank" rel="noreferrer">Open source</a>
            <a class="button secondary" href={github.releaseUrl} target="_blank" rel="noreferrer">Latest release</a>
          </div>
        </div>

        <aside class="project-meta-panel" aria-label={`${project.name} GitHub summary`}>
          <dl class="project-meta-grid">
            <div>
              <dt>Version</dt>
              <dd>{github.version}</dd>
            </div>
            <div>
              <dt>Language</dt>
              <dd>{github.language}</dd>
            </div>
            <div>
              <dt>Stars</dt>
              <dd>{github.stars}</dd>
            </div>
            <div>
              <dt>Forks</dt>
              <dd>{github.forks}</dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>{formatDate(github.updatedAt)}</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="project-showcase" aria-label={`${project.name} showcase`}>
        <picture>
          {heroImage.fallbackSrc && <source srcset={heroImage.src} type="image/webp" />}
          <img class={`showcase-image ${heroImage.fit ?? "cover"}`} src={heroImage.fallbackSrc ?? heroImage.src} alt={heroImage.alt} loading="eager" decoding="async" />
        </picture>
      </section>

      <section class="case-study-panel" aria-label={`${project.name} case study`}>
        <article>
          <span>Problem</span>
          <p>{project.caseStudy.problem}</p>
        </article>
        <article>
          <span>What I built</span>
          <p>{project.caseStudy.built}</p>
        </article>
        <article>
          <span>Result</span>
          <p>{project.caseStudy.result}</p>
        </article>
        <article>
          <span>Audience</span>
          <p>{project.audience}</p>
        </article>
      </section>

      <section class="project-detail-grid" aria-label={`${project.name} details`}>
        <div class="command-panel">
          <h2>Source and releases</h2>
          {github.commands.map((command) => (
            <div class="command-block">
              <span>{command.label}</span>
              <code>{command.command}</code>
            </div>
          ))}
        </div>

        <div class="highlights-panel">
          <h2>Highlights</h2>
          <ul>
            {project.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </div>
      </section>

      {galleryImages.length > 0 && (
        <section class="showcase-gallery" aria-label={`${project.name} gallery`}>
          {galleryImages.map((image) => (
            <figure>
              <picture>
                {image.fallbackSrc && <source srcset={image.src} type="image/webp" />}
                <img class={`showcase-image ${image.fit ?? "cover"}`} src={image.fallbackSrc ?? image.src} alt={image.alt} loading="lazy" decoding="async" />
              </picture>
            </figure>
          ))}
        </section>
      )}
    </main>
    <script>
      const downloadMenus = document.querySelectorAll<HTMLElement>("[data-download-menu]");

      const closeDownloadMenu = (menu: HTMLElement) => {
        const trigger = menu.querySelector("[data-download-trigger]");
        const options = menu.querySelector("[data-download-options]");

        menu.dataset.open = "false";
        trigger?.setAttribute("aria-expanded", "false");
        options?.setAttribute("aria-hidden", "true");
      };

      downloadMenus.forEach((menu) => {
        const trigger = menu.querySelector("[data-download-trigger]");
        const options = menu.querySelector("[data-download-options]");

        menu.dataset.open = "false";

        trigger?.addEventListener("click", () => {
          const willOpen = menu.dataset.open !== "true";

          downloadMenus.forEach((item) => {
            if (item !== menu) {
              closeDownloadMenu(item);
            }
          });

          menu.dataset.open = String(willOpen);
          trigger.setAttribute("aria-expanded", String(willOpen));
          options?.setAttribute("aria-hidden", String(!willOpen));
        });
      });

      document.addEventListener("click", (event) => {
        const target = event.target;

        if (!(target instanceof Node)) {
          return;
        }

        downloadMenus.forEach((menu) => {
          if (!menu.contains(target)) {
            closeDownloadMenu(menu);
          }
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") {
          return;
        }

        downloadMenus.forEach(closeDownloadMenu);
      });
    </script>
    <SpeedInsights />
  </body>
</html>

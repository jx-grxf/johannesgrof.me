---
import { getProjectCopy, localizedStatusLabel, statusClass, type Project, type ProjectLang } from "@/data/projects";

interface Props { project: Project; lang: ProjectLang }
const { project, lang } = Astro.props;
const copy = getProjectCopy(project, lang);
const image = project.showcase.find(image => image.kind !== "video");
const href = `${lang === "de" ? "/de" : ""}/projects/${project.slug}/`;
---

<article class="work-preview">
  <a class="work-preview-link" href={href}>
    {image && <span class="work-preview-media"><img class="work-preview-image" src={image.src} alt={lang === "de" ? image.altDe ?? image.alt : image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></span>}
    <div class="work-preview-copy">
      <p class="eyebrow">{project.stack.join(" · ")}</p>
      <div class="work-preview-title"><h3>{project.name}</h3><span aria-hidden="true">↗</span></div>
      <p>{copy.tagline}</p>
      <span class={`status ${statusClass(project.status)}`}>{localizedStatusLabel(project.status, lang)}</span>
    </div>
  </a>
</article>

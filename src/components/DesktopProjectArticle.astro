---
import { getProjectGitHubInfo } from "@/data/github";
import {
  getProjectCopy,
  localizedStatusLabel,
  type Project,
  type ProjectLang,
} from "@/data/projects";
interface Props {
  project: Project;
  lang: ProjectLang;
  initial?: boolean;
}
const { project: p, lang, initial = false } = Astro.props;
const de = lang === "de";
const t = (en: string, german: string) => (de ? german : en);
const copy = getProjectCopy(p, lang);
const github = await getProjectGitHubInfo(p);
const group = github.downloadGroup;
const downloads = [
  ...(group?.stableDownloads ?? (group?.stable ? [group.stable] : [])),
  ...(group?.prereleases ?? []),
];
const image = p.showcase.find((i) => i.kind !== "video");
const Title = initial ? "h1" : "h3";
---

<article data-project-detail={p.slug} hidden={!initial}>
  <div class="project-detail-heading">
    {p.logo && <img src={p.logo.src} width="76" height="76" alt="" />}
    <div>
      <span class="eyebrow">{p.stack.join(" · ")}</span><Title>{p.name}</Title
      ><span class="project-status"
        >{localizedStatusLabel(p.status, lang)}</span>
    </div>
  </div>
  <p class="project-tagline">{copy.tagline}</p>
  {
    image && (
      <img
        class="project-hero-image"
        src={image.src}
        alt={image.alt}
        loading={initial ? "eager" : "lazy"}
        width="1000"
        height="600"
      />
    )
  }
  <p>{copy.description}</p>
  <div class="project-links">
    {
      p.liveUrl && (
        <a class="primary-button" href={p.liveUrl} target="_blank" rel="noreferrer">
          {new URL(p.liveUrl).hostname} ↗
        </a>
      )
    }
    {
      p.visibility === "public" && (
        <a
          class="secondary-button"
          href={p.githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          GitHub ↗
        </a>
      )
    }
    <a
      class="secondary-button"
      href={`${de ? "/de" : ""}/classic/projects/${p.slug}/`}
      >{t("Reading view", "Leseansicht")} ↗</a
    >
    <button class="secondary-button" data-copy-project={p.slug}
      >{t("Copy project link", "Projektlink kopieren")} ↗</button
    >
  </div>
  {
    (downloads.length > 0 || p.npmPackage) && (
      <section class="project-downloads">
        <h4>{t("Get the app", "App herunterladen")}</h4>
        {p.npmPackage && (
          <div class="install-command">
            <code>npm install -g {p.npmPackage}</code>
            <button data-copy-text={`npm install -g ${p.npmPackage}`}>
              {t("Copy", "Kopieren")}
            </button>
          </div>
        )}
        {downloads.map((download) => (
          <a href={download.assetUrl} target="_blank" rel="noreferrer">
            <div>
              <strong>{download.label}</strong>
              <small>
                {download.tag} ·{" "}
                {download.prerelease
                  ? t("Preview", "Vorabversion")
                  : t("Stable", "Stabil")}{" "}
                · {download.detail}
              </small>
            </div>
            <span>↓</span>
          </a>
        ))}
        <p class="download-source">
          {github.metadataState === "live"
            ? t(
                "Release details retrieved at build time from GitHub.",
                "Release-Angaben beim Website-Build von GitHub abgerufen.",
              )
            : t(
                "Saved release details; GitHub was unavailable or incomplete at build time.",
                "Gespeicherte Release-Angaben; GitHub war beim Build nicht oder nur teilweise erreichbar.",
              )}
        </p>
      </section>
    )
  }
  <section class="project-case-study">
    <h4>{t("The problem", "Das Problem")}</h4><p>{copy.caseStudy.problem}</p><h4
    >
      {t("What I built", "Was ich gebaut habe")}
    </h4><p>{copy.caseStudy.built}</p><h4>Highlights</h4><ul>
      {copy.highlights.map((h) => <li>{h}</li>)}
    </ul>{
      copy.releaseHighlights?.length && (
        <>
          <>
            <h4>{t("Release highlights", "Release-Neuigkeiten")}</h4>
            <ul>
              {copy.releaseHighlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </>
        </>
      )
    }
  </section>
</article>

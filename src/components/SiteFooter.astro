---
// Shared footer. Every page needs it: the Impressum and Datenschutz links have
// to be reachable from any URL, including the project detail pages.
interface Props {
  lang?: "en" | "de";
}

const { lang = "de" } = Astro.props;
const isEn = lang === "en";
---

<footer class="site-footer">
  <p class="footer-brand">
    <strong>Johannes Grof IT</strong> · {isEn ? "South-East Styria, Austria" : "Südost-Steiermark, Österreich"}
  </p>
  <p class="footer-contact">
    <a href="mailto:contact@johannesgrof.me">contact@johannesgrof.me</a>
  </p>
  <p class="footer-legal">
    <a href="/impressum/">{isEn ? "Imprint" : "Impressum"}</a> ·
    <a href="/datenschutz/">{isEn ? "Privacy" : "Datenschutz"}</a>
  </p>
  <p class="footer-copy">© {new Date().getFullYear()} Johannes Grof</p>
</footer>

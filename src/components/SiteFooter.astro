---
import SocialLinks from "@/components/SocialLinks.astro";

// Shared footer. Every page needs it: the Impressum and Datenschutz links have
// to be reachable from any URL, including the project detail pages.
interface Props {
  lang?: "en" | "de";
}

const { lang = "de" } = Astro.props;
const isEn = lang === "en";
---

<footer class="site-footer">
  <div class="footer-top">
    <p class="footer-brand">
      <strong>Johannes Grof</strong><br />
      {isEn ? "South-East Styria, Austria" : "Südost-Steiermark, Österreich"}
    </p>
    <p class="footer-contact">
      <a href="mailto:contact@johannesgrof.me">contact@johannesgrof.me</a>
    </p>
    <SocialLinks variant="icons" />
    <p class="footer-links">
      <a href="/impressum/">{isEn ? "Imprint" : "Impressum"}</a>
      <a href="/datenschutz/">{isEn ? "Privacy" : "Datenschutz"}</a>
    </p>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Johannes Grof</p>
    <p>{isEn ? "Built with Astro, hosted on Vercel" : "Gebaut mit Astro, gehostet auf Vercel"}</p>
  </div>
</footer>

---
import SocialLinks from "@/components/SocialLinks.astro";

interface NavItem {
  label: string;
  href: string;
  external?: boolean;
}

interface LangSwitch {
  label: string;
  href: string;
  ariaLabel: string;
}

interface Props {
  navItems: NavItem[];
  ariaLabel?: string;
  homeHref?: string;
  langSwitch?: LangSwitch;
}

const { navItems, ariaLabel = "Primary navigation", homeHref = "/", langSwitch } = Astro.props;
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label="Johannes Grof home">
    <span class="brand-prompt" aria-hidden="true">$</span>
    <span>Johannes Grof</span>
  </a>
  <nav class="site-nav" aria-label={ariaLabel}>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <span class="nav-divider" aria-hidden="true"></span>
    <SocialLinks variant="icons" class="nav-socials" />
    {
      langSwitch && (
        <a class="lang-switch" href={langSwitch.href} aria-label={langSwitch.ariaLabel}>
          {langSwitch.label}
        </a>
      )
    }
  </nav>
</header>

---
import { author, canonicalOrigin, defaultSocialImage, personSameAs, toCanonicalUrl } from "@/data/siteMetadata";

interface HreflangAlternate {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  ogLocale?: string;
  hreflangAlternates?: HreflangAlternate[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = defaultSocialImage,
  imageAlt = "Johannes Grof project portfolio preview",
  type = "website",
  ogLocale = "en_US",
  hreflangAlternates = [],
  noindex = false,
} = Astro.props;

const canonicalUrl = toCanonicalUrl(canonicalPath);
const imageUrl = toCanonicalUrl(image);
// Only the branded default card has known 1200×630 dimensions; project pages
// pass their own screenshots, so we omit the explicit size for those.
const isDefaultImage = image === defaultSocialImage;

// Person is the same @id on every page; sameAs (incl. oeffigo.app) is the
// entity bridge that tells Google this site and ÖffiGo share one maker.
const personId = `${canonicalOrigin}/#person`;
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: author.name,
  url: canonicalOrigin,
  email: `mailto:${author.email}`,
  sameAs: personSameAs,
};

// WebSite entity, authored by the Person — only emitted on the home pages.
const isHome = canonicalPath === "/" || canonicalPath === "/de/" || canonicalPath === "/de";
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${canonicalOrigin}/#website`,
  url: canonicalOrigin,
  name: author.name,
  inLanguage: ["en", "de-AT"],
  author: { "@id": personId },
  publisher: { "@id": personId },
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<meta name="author" content="Johannes Grof" />
<meta name="theme-color" content="#12110f" />
{/* Runs before the first paint, so a reader who chose the light stock never
    sees the dark one flash first. No stored choice means dark. */}
<script is:inline>
  try {
    const stored = localStorage.getItem("theme");

    if (stored === "light" || stored === "dark") {
      document.documentElement.dataset.theme = stored;

      if (stored === "light") {
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#f4f2ed");
      }
    }
  } catch {
    /* Storage blocked — the default stock is already correct. */
  }
</script>
{noindex && <meta name="robots" content="noindex, nofollow" />}
<title>{title}</title>
<link rel="canonical" href={canonicalUrl} />
{hreflangAlternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta property="og:type" content={type} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content="Johannes Grof" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
{isDefaultImage && <meta property="og:image:type" content="image/png" />}
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
{isHome && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />}

  specSources,
  stabilityModes,
  xdriveLaunchLockBelowKmh,
  chartFrame,
  aquaplaning,
  aquaplaningMaxKmh,
  criticalSpeed,
  defaultRain,
  defaultTread,
  gearboxes,
  gripPath,
  rainLevels,
  treadDepths,
  wetGripLoss,
  type DriveProfile,
} from "@/data/drivetech";
import type { ProjectLang } from "@/data/projects";

interface Props {
  lang: ProjectLang;
  releaseUrl: string;
}

const { lang, releaseUrl } = Astro.props;
const de = lang === "de";
const num = (value: number, digits = 2) => new Intl.NumberFormat(de ? "de-AT" : "en", { maximumFractionDigits: digits }).format(value);
const pct = (value: number) => `${Math.round(value * 100)} %`;


---
// Small pixel sprites, drawn from text grids so they stay crisp at any size.
// The grids live in lib/sprites.ts. Colours are theme tokens, so a sprite
// follows the paper stock like everything else.
import { palette, sprites, type SpriteName } from "@/lib/sprites";

interface Props {
  name: SpriteName;
  class?: string;
  title?: string;
}

// Characters that animate: C blinks like a cursor, Q flickers like a candle.
const animated: Record<string, { fill: string; className: string }> = {
  C: { fill: palette.R, className: "pixel-blink" },
  Q: { fill: palette.Y, className: "pixel-flicker" },
};

const { name, class: className, title } = Astro.props;
const grid = sprites[name] as readonly string[];
const width = Math.max(...grid.map((row) => row.length));
const height = grid.length;

// Merge horizontal runs of the same colour into one rect to keep the markup small.
const rects: { x: number; y: number; w: number; fill: string; className?: string }[] = [];
grid.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    let run = 1;
    while (row[x + run] === ch) run++;
    const special = animated[ch];
    if (special) rects.push({ x, y, w: run, fill: special.fill, className: special.className });
    else if (ch !== "." && palette[ch]) rects.push({ x, y, w: run, fill: palette[ch] });
    x += run;
  }
});
---

<svg
  class:list={["pixel-sprite", className]}
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  shape-rendering="crispEdges"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
>
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" style={`fill:${r.fill}`} class={r.className} />)}
</svg>

---
/**
 * One app tile. Which artwork it draws is decided by ICON_SOURCE:
 * Apple's exported application icons, or the set drawn in this repository
 * (whose paths live in the sprite rendered once per page).
 */
import { APPLE_ICON_FILES, ICON_SOURCE } from "@/lib/appIcons";

interface Props {
  app: string;
  size?: number;
  /** Dock tiles carry the drop shadow; inline uses do not. */
  flat?: boolean;
  /** The dock and the desktop are visible on arrival, so their tiles load
   *  eagerly. Only tiles inside a closed surface — the Spotlight dialog —
   *  should wait. */
  loading?: "eager" | "lazy";
}

const { app, size = 60, flat = false, loading = "eager" } = Astro.props;
const file = APPLE_ICON_FILES[app];
---

{
  ICON_SOURCE === "apple" && file ? (
    <img class:list={["app-tile", { "app-tile-flat": flat }]} src={`/desktop/${file}`} width={size} height={size} alt="" loading={loading} decoding="async" />
  ) : (
    <svg class:list={["app-tile", { "app-tile-flat": flat }]} width={size} height={size} viewBox="0 0 100 100" role="presentation" aria-hidden="true">
      <use href={`#app-${app}`} />
    </svg>
  )
}

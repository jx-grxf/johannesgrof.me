---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  open?: boolean;
  lang: string;
}
const { id, title, subtitle, open = false, lang } = Astro.props;
const de = lang === "de";
---

<section
  class="os-window"
  id={`window-${id}`}
  data-window={id}
  data-maximized="false"
  hidden={!open}
  aria-labelledby={`title-${id}`}
  tabindex="-1"
>
  <header class="window-bar" data-drag-handle>
    <div class="traffic-lights">
      <button
        class="traffic close"
        data-window-action="close"
        aria-label={`${title}: ${de ? "Schließen" : "Close"}`}
        ><span>×</span></button
      >
      <button
        class="traffic minimize"
        data-window-action="minimize"
        aria-label={`${title}: ${de ? "Minimieren" : "Minimize"}`}
        ><span>−</span></button
      >
      <button
        class="traffic maximize"
        data-window-action="maximize"
        aria-label={`${title}: ${de ? "Fenstergröße umschalten" : "Toggle window size"}`}
        ><span>↗</span></button
      >
    </div>
    <div class="window-heading">
      <h2 id={`title-${id}`}>{title}</h2>{subtitle && <span>{subtitle}</span>}
    </div>
    <button
      class="window-reset"
      data-window-action="center"
      aria-label={de ? "Fenster zentrieren" : "Center window"}>⌖</button
    >
  </header>
  <div class="window-content"><slot /></div>
  <button
    class="resize-handle"
    data-resize-handle
    aria-label={de
      ? "Fenstergröße ändern: Pfeiltasten verwenden"
      : "Resize window: use arrow keys"}>◢</button
  >
</section>

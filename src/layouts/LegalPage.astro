---
import BaseHead from "@/components/BaseHead.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;

const navItems = [{ label: "Start", href: "/" }];
---

<!doctype html>
<html lang="de-AT">
  <head>
    <BaseHead title={title} description={description} canonicalPath={canonicalPath} ogLocale="de_AT" />
  </head>
  <body>
    <SiteHeader navItems={navItems} ariaLabel="Seitennavigation" homeHref="/" />

    <main class="legal-page section-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-brand"><strong>Johannes Grof IT</strong> · Südost-Steiermark, Österreich</p>
      <p class="footer-contact">
        <a href="mailto:contact@johannesgrof.me">contact@johannesgrof.me</a>
      </p>
      <p class="footer-legal">
        <a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a>
      </p>
      <p class="footer-copy">© {new Date().getFullYear()} Johannes Grof</p>
    </footer>

    <style>
      .legal-page {
        max-width: 760px;
        margin-inline: auto;
        padding-block: clamp(48px, 8vw, 96px);
      }

      .legal-page :global(h1) {
        margin-bottom: 8px;
      }

      .legal-page :global(.legal-updated) {
        color: var(--muted, #8a8a99);
        font-size: 0.9rem;
        margin-bottom: 40px;
      }

      .legal-page :global(h2) {
        margin-top: 40px;
        margin-bottom: 12px;
        font-size: 1.15rem;
      }

      .legal-page :global(p),
      .legal-page :global(li) {
        line-height: 1.7;
      }

      .legal-page :global(address) {
        font-style: normal;
        line-height: 1.7;
      }

      .legal-page :global(ul) {
        padding-left: 1.2rem;
      }

      .legal-page :global(.legal-placeholder) {
        background: color-mix(in srgb, #f5a623 22%, transparent);
        border-radius: 4px;
        padding: 1px 6px;
        font-weight: 600;
      }

      .legal-page :global(.legal-draft-note) {
        border: 1px solid color-mix(in srgb, #f5a623 45%, transparent);
        background: color-mix(in srgb, #f5a623 12%, transparent);
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 32px;
        font-size: 0.92rem;
      }

      .legal-page :global(a) {
        text-decoration: underline;
      }
    </style>
  </body>
</html>

---
import AppIcon from "@/components/DesktopAppIcon.astro";
import AppIconSprite from "@/components/DesktopAppIconSprite.astro";
import BaseHead from "@/components/BaseHead.astro";
import ContactForm from "@/components/ContactForm.astro";
import DesktopProjectArticle from "@/components/DesktopProjectArticle.astro";
import Icon from "@/components/DesktopIcon.astro";
import Window from "@/components/DesktopWindow.astro";
import { featuredShowcaseProjects, getProjectCopy, localizedStatusLabel, publicProjects } from "@/data/projects";
import type { LocaleContent } from "@/data/siteContent";
import { toCanonicalUrl } from "@/data/siteMetadata";
import "@/styles/desktop.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  content: LocaleContent;
  canonicalPath: string;
  initialProject?: string;
}

const { content, canonicalPath, initialProject } = Astro.props;
const de = content.lang !== "en";
const lang = de ? "de" : "en";
const prefix = de ? "/de" : "";
const t = (en: string, german: string) => (de ? german : en);

const projects = publicProjects.map((project) => ({
  ...project,
  copy: getProjectCopy(project, lang),
  category: project.stack.some((s) => /Swift|AppKit|macOS/.test(s))
    ? "native"
    : project.stack.some((s) => /Astro|Vite/.test(s))
      ? "web"
      : "tools",
}));

// The reading view and the desktop show the same three, from one list.
const featured = featuredShowcaseProjects.map((project) => projects.find((p) => p.slug === project.slug)).filter((p) => p !== undefined);

const archived = projects.filter((project) => project.status === "archived");

// The reading view's hero counts the ones with a public repository, which is a
// smaller number than the catalogue. Both appear in the Finder's status bar so
// the two pages cannot look like they disagree.
const shipped = projects.filter((project) => project.visibility === "public").length;

// Screenshots the Preview window flips through. Only projects that actually
// have a picture; a gallery of placeholders is worse than a shorter gallery.
const gallery = projects
  .map((project) => ({ project, shot: project.showcase.find((item) => item.kind !== "video") }))
  .filter((entry) => entry.shot !== undefined);

const initial = projects.find((project) => project.slug === initialProject);

const pageTitle = initial ? `${initial.name} · Johannes Grof` : content.meta.title;
const pageDescription = initial ? initial.copy.tagline : content.meta.description;

const socialSource = initial?.showcase.find((item) => item.kind !== "video");
const socialImage = socialSource?.fallbackSrc ?? (socialSource && !socialSource.src.endsWith(".webp") ? socialSource.src : undefined);
const alternateSuffix = initial ? `projects/${initial.slug}/` : "";

const apps = [
  { id: "welcome", title: t("About me", "Über mich") },
  { id: "finder", title: t("Projects", "Projekte") },
  { id: "preview", title: t("Preview", "Vorschau") },
  { id: "editor", title: t("Notes", "Notizen") },
  { id: "terminal", title: "Terminal" },
  { id: "workshop", title: t("Workshop", "Werkstatt") },
  { id: "contact", title: t("Contact", "Kontakt") },
  { id: "settings", title: t("Settings", "Einstellungen") },
];

// Windows the Window menu can toggle, in the order they appear there.
const windowMenu = [...apps, { id: "archive", title: t("Archive", "Archiv") }];

// Read by the Workshop module to decide which repositories are worth listing,
// and by the Terminal for `ls` and `project <name>`. Rendering them keeps the
// client in step with the project data without a second copy of the catalogue.
const repoCatalogue = [...projects.map((project) => project.repo.split("/")[1]), "rust_learning", "typescript_learning", "homebrew-tap", "scoop-bucket"];
const projectIndex = projects.map((project) => ({ name: project.name, slug: project.slug }));

const editorText = t(
  "Scratch pad.\n\nType whatever you want in here — it stays in this browser and\nnever leaves your machine. Download it if you want to keep it.\n\n— Johannes",
  "Notizblock.\n\nSchreib hier rein was du willst — bleibt in diesem Browser und\ngeht nirgendwohin. Wenn du es behalten willst, lad es runter.\n\n— Johannes",
);
---

<!doctype html>
<html lang={content.lang} data-desktop="true">
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      image={socialImage}
      imageAlt={socialImage ? socialSource?.alt : undefined}
      type={initial ? "article" : "website"}
      canonicalPath={canonicalPath}
      ogLocale={content.ogLocale}
      hreflangAlternates={[
        { hreflang: "en", href: toCanonicalUrl(`/${alternateSuffix}`) },
        { hreflang: "de-AT", href: toCanonicalUrl(`/de/${alternateSuffix}`) },
        { hreflang: "x-default", href: toCanonicalUrl(`/${alternateSuffix}`) },
      ]}
    />
    <script is:inline>
      // Appearance is settled before the first paint, so a visitor who chose
      // dark never sees the light desktop flash first.
      try {
        const stored = JSON.parse(localStorage.getItem("jg-desktop-preferences") || "{}");
        document.documentElement.dataset.desktopTheme = stored.theme === "dark" ? "dark" : "light";
        document.documentElement.dataset.wallpaper = ["dawn", "styria", "ink"].includes(stored.wallpaper) ? stored.wallpaper : "dawn";
      } catch {}
    </script>
  </head>

  <body class="desktop-page" data-lang={lang} data-initial-project={initialProject}>
    <AppIconSprite />
    <a class="skip-link" href="#desktop-main">{t("Skip to the portfolio", "Zum Portfolio springen")}</a>
    <div class="desktop-wallpaper" aria-hidden="true"></div>

    <header class="menubar">
      <div class="menubar-menus" role="menubar" aria-label={t("Main menu", "Hauptmenü")}>
        <div class="menu-slot" role="none">
          <button
            class="brand-button"
            role="menuitem"
            data-menu-button
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="menu-brand"
            aria-label={t("Desktop menu", "Desktop-Menü")}>✳</button
          >
          <ul class="menu-list" id="menu-brand" role="menu" data-menu-list hidden>
            <li role="none"><button role="menuitem" data-open="welcome">{t("About this desktop", "Über diesen Desktop")}</button></li>
            <li role="none"><button role="menuitem" data-open="settings">{t("Settings…", "Einstellungen…")}</button></li>
            <li role="none" class="menu-separator"></li>
            <li role="none"><a role="menuitem" href={`${prefix}/classic/`}>{t("Reading view", "Leseansicht")}</a></li>
            <li role="none" class="menu-separator"></li>
            <li role="none"><a role="menuitem" href="/impressum/">{t("Legal notice", "Impressum")}</a></li>
            <li role="none"><a role="menuitem" href="/datenschutz/">{t("Privacy", "Datenschutz")}</a></li>
          </ul>
        </div>

        <div class="menu-slot" role="none">
          <button class="menu-title menu-app-name" role="menuitem" data-menu-button aria-haspopup="true" aria-expanded="false" aria-controls="menu-me">Johannes Grof</button>
          <ul class="menu-list" id="menu-me" role="menu" data-menu-list hidden>
            <li role="none"><button role="menuitem" data-open="welcome">{t("About me", "Über mich")}</button></li>
            <li role="none"><button role="menuitem" data-open="workshop">{t("Workshop", "Werkstatt")}</button></li>
            <li role="none"><button role="menuitem" data-open="contact">{t("Write to me", "Schreib mir")}</button></li>
            <li role="none" class="menu-separator"></li>
            <li role="none"><a role="menuitem" href="mailto:contact@johannesgrof.me">contact@johannesgrof.me</a></li>
            <li role="none"><a role="menuitem" href="https://github.com/jx-grxf" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
            <li role="none">
              <a role="menuitem" href="https://www.linkedin.com/in/johannes-grof" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
            </li>
          </ul>
        </div>

        <div class="menu-slot" role="none">
          <button class="menu-title" role="menuitem" data-menu-button aria-haspopup="true" aria-expanded="false" aria-controls="menu-projects">{t("Projects", "Projekte")}</button>
          <ul class="menu-list" id="menu-projects" role="menu" data-menu-list hidden>
            <li role="none"><button role="menuitem" data-open="finder">{t("All projects", "Alle Projekte")}</button></li>
            <li role="none" class="menu-separator"></li>
            {featured.map((project) => (
              <li role="none">
                <button role="menuitem" data-open="project" data-project={project.slug}>
                  {project.name}
                </button>
              </li>
            ))}
            <li role="none" class="menu-separator"></li>
            <li role="none"><button role="menuitem" data-open="project" data-project="oeffigo">ÖffiGo</button></li>
            <li role="none"><button role="menuitem" data-open="preview">{t("Screenshots", "Screenshots")}</button></li>
            <li role="none"><button role="menuitem" data-open="archive">{t("Archive", "Archiv")}</button></li>
          </ul>
        </div>

        <div class="menu-slot" role="none">
          <button class="menu-title" role="menuitem" data-menu-button aria-haspopup="true" aria-expanded="false" aria-controls="menu-windows">{t("Window", "Fenster")}</button>
          <ul class="menu-list" id="menu-windows" role="menu" data-menu-list data-window-menu hidden>
            {windowMenu.map((app) => (
              <li role="none">
                <button role="menuitemcheckbox" aria-checked="false" data-window-menu-item={app.id} data-open={app.id}>
                  {app.title}
                </button>
              </li>
            ))}
            <li role="none" class="menu-separator"></li>
            <li role="none"><button role="menuitem" data-reset-windows>{t("Tidy the windows", "Fenster aufräumen")}</button></li>
            <li role="none"><button role="menuitem" data-close-all-windows>{t("Close all", "Alle schließen")}</button></li>
          </ul>
        </div>
      </div>

      <div class="menu-status">
        <button class="status-item weather-status" data-weather-status data-open="widgets" hidden aria-label={t("Weather", "Wetter")}></button>

        <div class="menu-slot" role="none">
          <button
            class="status-item language-button"
            data-menu-button
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="menu-language"
            aria-label={t("Language", "Sprache")}
          >
            <Icon name="globe" size={16} />{de ? "DE" : "EN"}
          </button>
          <ul class="menu-list menu-list-right" id="menu-language" role="menu" data-menu-list hidden>
            <li role="none">
              <a role="menuitemradio" aria-checked={de ? "false" : "true"} href={`/${alternateSuffix}`} data-set-lang="en" hreflang="en" lang="en">English</a>
            </li>
            <li role="none">
              <a role="menuitemradio" aria-checked={de ? "true" : "false"} href={`/de/${alternateSuffix}`} data-set-lang="de" hreflang="de-AT" lang="de">Deutsch</a>
            </li>
          </ul>
        </div>

        <button class="status-item" data-spotlight-toggle aria-label={t("Search", "Suchen")}><Icon name="search" size={17} /></button>
        <button class="status-item" data-open="settings" aria-label={t("Settings", "Einstellungen")}><Icon name="settings" size={17} /></button>
        <button class="status-item menu-clock-button" data-open="widgets" aria-label={t("Clock and focus", "Uhr und Fokus")}><time data-menu-clock>--:--</time></button>
      </div>
    </header>

    {/* Offered rather than redirected: an automatic jump would hide the other
        locale and fight the canonical URL. */}
    <div class="lang-hint" data-lang-hint hidden>
      <span>Diese Seite gibt es auch auf Deutsch.</span>
      <a href={`/de/${alternateSuffix}`} data-set-lang="de">Auf Deutsch ansehen</a>
      <button data-lang-hint-dismiss aria-label="Hinweis schließen">×</button>
    </div>

    <main id="desktop-main" class="desktop-workspace">
      <aside class="desktop-widgets" aria-label={t("Widgets", "Widgets")}>
        <div class="clock-widget widget">
          <div class="widget-overline"><span class="status-dot"></span>FELDBACH · AT</div>
          <time class="big-clock" data-vienna-clock>--:--</time>
          <p data-vienna-date>Europe / Vienna</p>
          <div class="day-track"><span data-day-progress></span></div>
        </div>

        <div class="weather-widget widget" data-weather data-state="loading">
          <div class="widget-overline">{t("WEATHER", "WETTER")}</div>
          <div class="weather-columns">
            <div data-weather-visitor hidden></div>
            <div data-weather-home hidden></div>
          </div>
          <p class="weather-placeholder">{t("Checking the weather…", "Wetter wird geholt…")}</p>
          <span class="widget-footnote"
            >{t("Data: ", "Daten: ")}<a href="https://open-meteo.com" target="_blank" rel="noreferrer">Open-Meteo</a>{" (CC BY 4.0)"}</span
          >
        </div>

        <button class="activity-widget widget" data-open="workshop">
          <div class="widget-overline"><span class="status-dot"></span>{t("LAST PUSH", "ZULETZT GEPUSHT")}<Icon name="arrow" size={16} /></div>
          <strong data-latest-project>GitHub</strong>
          <p data-latest-description>{t("Loading the last commit…", "Letzter Commit wird geladen…")}</p>
          <span class="widget-footnote" data-widget-status></span>
        </button>

        <div class="focus-widget widget">
          <div class="widget-overline">
            <Icon name="coffee" size={18} />{t("FOCUS · 25 MIN", "FOKUS · 25 MIN")}
            <button data-focus-reset aria-label={t("Reset", "Zurücksetzen")}>↺</button>
          </div>
          <div class="focus-controls">
            <time data-focus-time>25:00</time>
            <button data-focus-toggle aria-label={t("Start timer", "Timer starten")}>▶</button>
          </div>
          <p data-focus-label>{t("25 minutes, one thing.", "25 Minuten, eine Sache.")}</p>
        </div>
      </aside>

      <nav class="desktop-files" aria-label={t("Shortcuts", "Verknüpfungen")}>
        <button data-open="finder">
          <AppIcon app="finder" size={68} />
          <span>{t("Projects", "Projekte")}</span>
          <small>{projects.length}</small>
        </button>
        <button data-open="project" data-project="oeffigo">
          <img src="/projects/oeffigo/icon.webp" width="62" height="62" alt="" />
          <span>ÖffiGo</span>
          <small>{t("iOS · Android", "iOS · Android")}</small>
        </button>
        <button data-open="editor">
          <AppIcon app="editor" size={62} />
          <span>{t("Notes", "Notizen")}</span>
        </button>
        <button data-open="archive">
          <AppIcon app="archive" size={62} />
          <span>{t("Archive", "Archiv")}</span>
          <small>{archived.length}</small>
        </button>
      </nav>

      <Window id="welcome" title={t("About me", "Über mich")} subtitle="Johannes Grof" open={!initialProject} lang={lang}>
        <div class="welcome-layout">
          <aside class="finder-sidebar welcome-sidebar">
            <span class="sidebar-caption">{t("HERE", "HIER")}</span>
            <button class="selected" data-open="welcome"><Icon name="home" size={18} />{t("About me", "Über mich")}</button>
            <button data-open="finder"><Icon name="folder" size={18} />{t("Projects", "Projekte")}<small>{projects.length}</small></button>
            <button data-welcome-section="services"><Icon name="heart" size={18} />{t("What I can do for you", "Was ich für dich tun kann")}</button>
            <button data-open="contact"><Icon name="mail" size={18} />{t("Write to me", "Schreib mir")}</button>
            <span class="sidebar-caption">{t("ALSO HERE", "AUCH DA")}</span>
            <button data-open="workshop"><Icon name="activity" size={18} />{t("Workshop", "Werkstatt")}</button>
            <button data-open="preview"><Icon name="browser" size={18} />Screenshots</button>
            <button data-open="terminal"><Icon name="terminal" size={18} />Terminal</button>
            <div class="sidebar-bottom">
              <span class="tiny-avatar">jg.</span>
              <div>Johannes Grof<small>HTL Kaindorf</small></div>
            </div>
          </aside>

          <div class="welcome-main">
            <div class="hello-kicker"><span class="status-dot"></span>{t("SOUTH-EAST STYRIA, AUSTRIA", "SÜDOST-STEIERMARK")}</div>
            <h1>{t("Hey, I'm", "Hey, ich bin")}<br />Johannes<span class="orange-period">.</span></h1>
            <p class="welcome-lead">{t("I build Mac apps, developer tools and websites.", "Ich bau Mac-Apps, Developer-Tools und Websites.")}</p>
            <p class="welcome-description">
              {
                t(
                  "Most of it started because something annoyed me: a workflow with too many clicks, a device that wouldn't cooperate, an app that should exist and didn't. On the side I help people around here with websites, repairs, and technology that has stopped playing along.",
                  "Das meiste ist entstanden, weil mich etwas genervt hat: ein Ablauf mit zu vielen Klicks, ein Gerät das nicht will, eine App die es geben müsste und nicht gibt. Nebenbei helfe ich in der Gegend bei Websites, Reparaturen und Technik, die grad nicht mag.",
                )
              }
            </p>
            <div class="welcome-actions">
              <button class="primary-button" data-open="finder">{t("Look at the projects", "Projekte anschauen")}<span aria-hidden="true">↗</span></button>
              <button class="text-button" data-open="contact">{t("Write to me", "Schreib mir")}<Icon name="arrow" size={16} /></button>
            </div>

            <div class="section-label">
              <span>{t("THREE THAT ARE RUNNING", "DREI, DIE LAUFEN")}</span>
              <button data-open="finder">{t("All of them", "Alle")} ↗</button>
            </div>
            <div class="featured-apps">
              {featured.map((project) => (
                <a href={`${prefix}/projects/${project.slug}/`} data-open="project" data-project={project.slug} class="featured-app">
                  <img src={project.logo?.src} width="47" height="47" alt="" />
                  <strong>{project.name}</strong>
                  <span>{project.copy.tagline}</span>
                  <span class="app-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>

            <section class="welcome-services" id="desktop-services">
              <div class="section-label">{t("NOT ONLY MY OWN PROJECTS", "NICHT NUR EIGENE PROJEKTE")}</div>
              <h3>{t("Need a hand with technology?", "Brauchst du wo Hilfe mit Technik?")}</h3>
              <p>{content.services.lead}</p>
              <div class="service-grid">
                {content.services.items.map((item) => (
                  <article>
                    <h4>{item.title}</h4>
                    <p>{item.body}</p>
                  </article>
                ))}
              </div>
              <button class="primary-button" data-open="contact">{t("Tell me about it", "Erzähl mir davon")} ↗</button>
            </section>

            <section class="about-detail">
              <h3>{content.about.title}</h3>
              <p>{content.about.body}</p>
              <a href="https://github.com/jx-grxf" target="_blank" rel="noreferrer">GitHub ↗</a>
              <a href="https://www.linkedin.com/in/johannes-grof" target="_blank" rel="noreferrer">LinkedIn ↗</a>
            </section>
          </div>
        </div>
      </Window>

      <Window id="finder" title={t("Projects", "Projekte")} subtitle="Finder" lang={lang}>
        <div class="finder-layout">
          <aside class="finder-sidebar">
            <span class="sidebar-caption">{t("COLLECTIONS", "SAMMLUNGEN")}</span>
            {
              [
                ["all", t("Everything", "Alles"), "folder"],
                ["native", "macOS & iOS", "grid"],
                ["web", "Web", "browser"],
                ["tools", t("Tools & automation", "Tools & Automation"), "terminal"],
              ].map(([id, label, icon]) => (
                <button data-filter={id} class:list={{ selected: id === "all" }}>
                  <Icon name={icon} size={18} />
                  {label}
                </button>
              ))
            }
            <span class="sidebar-caption">{t("ELSEWHERE", "WOANDERS")}</span>
            <button data-open="project" data-project="oeffigo"><Icon name="train" size={18} />ÖffiGo</button>
            <button data-open="preview"><Icon name="browser" size={18} />Screenshots</button>
            <button data-open="workshop"><Icon name="activity" size={18} />{t("Workshop", "Werkstatt")}</button>
          </aside>

          <div class="finder-main">
            <div class="finder-toolbar">
              <label class="search-field">
                <Icon name="search" size={17} />
                <input data-project-search type="search" placeholder={t("Search…", "Suchen…")} aria-label={t("Search projects", "Projekte suchen")} />
              </label>
              <button class="icon-button" data-view-toggle aria-label={t("Switch to list view", "Auf Listenansicht umschalten")} aria-pressed="false"><Icon name="list" size={20} /></button>
            </div>

            <div class="project-grid" data-project-grid>
              {projects.map((project) => (
                <a
                  class="project-file"
                  href={`${prefix}/projects/${project.slug}/`}
                  data-open="project"
                  data-project={project.slug}
                  data-category={project.category}
                  data-search={`${project.name} ${project.copy.tagline} ${project.stack.join(" ")}`.toLowerCase()}
                >
                  {project.logo ? (
                    <img src={project.logo.src} width="64" height="64" alt="" loading="lazy" />
                  ) : (
                    <span class={`generated-app-icon ${project.category}`}>
                      <Icon name={project.category === "tools" ? "terminal" : project.category === "web" ? "browser" : "code"} size={32} />
                    </span>
                  )}
                  <strong>{project.name}</strong>
                  <span>{project.copy.tagline}</span>
                  <small>{localizedStatusLabel(project.status, lang)}</small>
                </a>
              ))}
            </div>

            <p class="empty-state" data-project-empty hidden>{t("Nothing matches that.", "Dazu gibt es nichts.")}</p>
            <footer class="finder-status">
              <span data-project-count>{projects.length} {t("projects", "Projekte")}</span>
              <span>{shipped} {t("of them public", "davon öffentlich")}</span>
            </footer>
          </div>
        </div>
      </Window>

      {/* Only the project a deep link asked for is rendered here. The rest are
          fetched from /partials/projects/:slug/ when they are opened, which is
          what keeps this page from shipping seventeen case studies at once. */}
      <Window id="project" title={initial?.name ?? t("Project", "Projekt")} open={!!initialProject} lang={lang}>
        <div class="project-detail-content">
          {initial && <DesktopProjectArticle project={initial} lang={lang} initial />}
          <article data-project-detail="oeffigo" hidden>
            <div class="project-detail-heading">
              <img src="/projects/oeffigo/icon.webp" width="76" height="76" alt="" />
              <div>
                <span class="eyebrow">iOS · Android · Österreich</span>
                <h3>ÖffiGo</h3>
              </div>
            </div>
            <p class="project-tagline">{t("Austria's public transport, done properly.", "Österreichs Öffis, ordentlich gemacht.")}</p>
            <img class="project-hero-image" src="/projects/oeffigo/showcase.webp" width="1000" height="600" loading="lazy" alt={t("ÖffiGo app preview", "Vorschau der ÖffiGo-App")} />
            <p>
              {
                t(
                  "Departures, journeys and nearby stops in one app, with every time labelled as either live from the operator or straight from the timetable.",
                  "Abfahrten, Routen und Haltestellen in einer App — und jede Zeit ist beschriftet, ob sie live vom Betreiber kommt oder aus dem Fahrplan.",
                )
              }
            </p>
            <div class="project-links">
              <a class="primary-button" href={`${prefix}/oeffigo/`}>{t("ÖffiGo in detail", "ÖffiGo im Detail")} ↗</a>
              <a class="secondary-button" href="https://oeffigo.app" target="_blank" rel="noreferrer">oeffigo.app ↗</a>
            </div>
          </article>
        </div>
        <p class="window-loading" aria-live="polite">{t("Loading…", "Wird geladen…")}</p>
        <div class="window-error" data-project-error hidden role="alert">
          <p>{t("That project did not load.", "Das Projekt ist nicht geladen.")}</p>
          <div>
            <button class="secondary-button" data-project-retry>{t("Try again", "Nochmal versuchen")}</button>
            <a class="secondary-button" data-project-fallback href="/">{t("Open the full page", "Ganze Seite öffnen")} ↗</a>
          </div>
        </div>
      </Window>

      <Window id="preview" title="Screenshots" subtitle={t("Preview", "Vorschau")} lang={lang}>
        <div class="preview-layout">
          <aside class="finder-sidebar">
            <span class="sidebar-caption">{t("SCREENSHOTS", "SCREENSHOTS")}</span>
            {gallery.map((entry, index) => (
              <button data-preview-pick={entry.project.slug} class:list={{ selected: index === 0 }} aria-current={index === 0 ? "true" : "false"}>
                {entry.project.logo ? <img src={entry.project.logo.src} width="18" height="18" alt="" loading="lazy" /> : <Icon name="code" size={18} />}
                {entry.project.name}
              </button>
            ))}
          </aside>
          <div class="preview-main">
            {gallery.map((entry, index) => (
              <figure data-preview-entry={entry.project.slug} hidden={index > 0}>
                <img src={entry.shot!.src} alt={entry.shot!.alt} loading={index === 0 ? "eager" : "lazy"} width="1200" height="750" />
                <figcaption>
                  <div>
                    <strong>{entry.project.name}</strong>
                    <p>{entry.project.copy.tagline}</p>
                  </div>
                  <div class="preview-actions">
                    <button class="secondary-button" data-open="project" data-project={entry.project.slug}>{t("Details", "Details")}</button>
                    {entry.project.liveUrl && (
                      <a class="secondary-button" href={entry.project.liveUrl} target="_blank" rel="noreferrer">
                        {new URL(entry.project.liveUrl).hostname} ↗
                      </a>
                    )}
                  </div>
                </figcaption>
              </figure>
            ))}
            <p class="preview-note" data-preview-note></p>
          </div>
        </div>
      </Window>

      <Window id="editor" title="notes.txt" subtitle={t("Notes", "Notizen")} lang={lang}>
        <div class="editor-toolbar">
          <label class="file-open secondary-button">
            {t("Open a file", "Datei öffnen")}
            <input type="file" data-editor-file accept=".txt,.md,.csv,.json,.ts,.js,.css,.html" />
          </label>
          <button class="secondary-button" data-editor-download>{t("Download", "Herunterladen")} ↓</button>
          <button class="text-button" data-editor-wrap aria-pressed="true">{t("Wrap lines", "Zeilenumbruch")}</button>
        </div>
        <label class="sr-only" for="text-editor">{t("Your notes", "Deine Notizen")}</label>
        <textarea id="text-editor" class="text-editor" spellcheck="false" data-editor>{editorText}</textarea>
        <footer class="editor-status">
          <span data-editor-status></span>
          <span data-editor-count></span>
        </footer>
      </Window>

      <Window id="terminal" title="johannes — zsh" subtitle="Terminal" lang={lang}>
        <div class="terminal-surface">
          <pre class="terminal-banner">   _        
  (_)  __ _ 
  | | / _` |
  | || (_| |
 _/ | \__, |
|__/  |___/ </pre>
          <p>{t("Type help to see what works.", "Tipp help, dann siehst du was geht.")}</p>
          <div data-terminal-output role="log" aria-live="polite"></div>
          <form data-terminal-form>
            <label for="terminal-input">guest@johannes ~ %</label>
            <input id="terminal-input" data-terminal-input autocomplete="off" autocapitalize="off" spellcheck="false" aria-label={t("Command", "Befehl")} />
          </form>
        </div>
      </Window>

      <Window id="workshop" title={t("Workshop", "Werkstatt")} subtitle="github.com/jx-grxf" lang={lang}>
        <div class="workshop-content">
          <div class="activity-topline">
            <div class="workshop-tabs" role="tablist" aria-label={t("Workshop sections", "Werkstatt-Bereiche")}>
              <button role="tab" data-workshop-tab="commits" aria-selected="true">{t("Commits", "Commits")}</button>
              <button role="tab" data-workshop-tab="releases" aria-selected="false">Releases</button>
              <button role="tab" data-workshop-tab="repos" aria-selected="false">Repos</button>
            </div>
            <button class="secondary-button" data-refresh-github>{t("Refresh", "Aktualisieren")} ↻</button>
          </div>
          <p class="workshop-status" data-github-status role="status"></p>

          <div data-workshop-panel="commits" class="workshop-panel">
            <div data-commit-feed class="commit-feed"></div>
          </div>
          <div data-workshop-panel="releases" class="workshop-panel" hidden>
            <div data-release-feed class="release-feed"></div>
          </div>
          <div data-workshop-panel="repos" class="workshop-panel" hidden>
            <div data-repo-feed class="repo-feed"></div>
          </div>

          <div class="learning-shelf">
            <span class="section-label">{t("CURRENTLY LEARNING", "GERADE AM LERNEN")}</span>
            <a href="https://github.com/jx-grxf/rust_learning" target="_blank" rel="noreferrer">
              <span class="learning-icon rust">Rs</span>
              <div><strong>Rust</strong><p>{t("Learning by building.", "Lernen durchs Bauen.")}</p></div>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="https://github.com/jx-grxf/typescript_learning" target="_blank" rel="noreferrer">
              <span class="learning-icon typescript">TS</span>
              <div><strong>TypeScript</strong><p>{t("Small exercises, better foundations.", "Kleine Übungen, bessere Grundlagen.")}</p></div>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </Window>

      <Window id="contact" title={t("New message", "Neue Nachricht")} subtitle={t("Contact", "Kontakt")} lang={lang}>
        <div class="mail-recipient">
          <span>{t("To:", "An:")}</span>
          <a href="mailto:contact@johannesgrof.me">Johannes Grof &lt;contact@johannesgrof.me&gt;</a>
        </div>
        <div class="contact-content">
          <h3>{t("What do you need?", "Was brauchst du?")}</h3>
          <p>{content.contact.note}</p>
          <ContactForm content={content.contact.form} lang={lang} />
        </div>
      </Window>

      <Window id="settings" title={t("Settings", "Einstellungen")} lang={lang}>
        <div class="settings-content">
          <div class="settings-profile">
            <span class="profile-monogram">jg.</span>
            <h3>{t("Desktop", "Desktop")}</h3>
            <p>{t("Stays in this browser.", "Bleibt in diesem Browser.")}</p>
          </div>

          <h4>{t("Appearance", "Erscheinungsbild")}</h4>
          <div class="segmented-control">
            {
              [
                ["light", t("Light", "Hell")],
                ["dark", t("Dark", "Dunkel")],
              ].map(([value, label]) => (
                <button data-desktop-theme={value} aria-pressed={value === "light"}>
                  {label}
                </button>
              ))
            }
          </div>

          <h4>{t("Wallpaper", "Hintergrund")}</h4>
          <div class="wallpaper-options">
            {
              [
                ["dawn", t("Dawn", "Morgen")],
                ["styria", t("Styria", "Steiermark")],
                ["ink", t("Ink", "Tinte")],
              ].map(([value, label]) => (
                <button data-wallpaper={value} aria-pressed={value === "dawn"}>
                  <span class={`wallpaper-swatch ${value}`} />
                  {label}
                </button>
              ))
            }
          </div>

          <div class="settings-row">
            <span>{t("Prefer a normal website?", "Lieber eine normale Website?")}</span>
            <a href={`${prefix}/classic/`}>{t("Reading view", "Leseansicht")} ↗</a>
          </div>
          <div class="settings-row">
            <span>{t("Windows gone astray?", "Fenster verlegt?")}</span>
            <button class="secondary-button" data-reset-windows>{t("Tidy up", "Aufräumen")}</button>
          </div>

          <p class="settings-hint">
            ⌘ / Ctrl + K · {t("Search", "Suchen")}<br />
            {t("Esc closes menus and search.", "Esc schließt Menüs und Suche.")}<br />
            {t("Notes and settings never leave this browser.", "Notizen und Einstellungen verlassen diesen Browser nicht.")}
          </p>
        </div>
      </Window>

      <Window id="widgets" title={t("Clock, weather, focus", "Uhr, Wetter, Fokus")} lang={lang}>
        <div data-widget-host class="widget-host"></div>
      </Window>

      {/* The trash used to hold three invented filenames as a joke. It holds the
          projects I actually stopped working on instead — they stay readable. */}
      <Window id="archive" title={t("Archive", "Archiv")} subtitle={t("Not continued", "Nicht weitergeführt")} lang={lang}>
        <div class="archive-content">
          <h3>{t("Things I stopped working on.", "Sachen, die ich nicht weiterführe.")}</h3>
          <p>
            {
              t(
                "They are still here, and the code is still up. Something replaced them, or the problem went away.",
                "Sie stehen trotzdem da, und der Code ist noch online. Entweder hat sie was abgelöst oder das Problem hat sich erledigt.",
              )
            }
          </p>
          <ul class="archive-list">
            {archived.map((project) => (
              <li>
                <button data-open="project" data-project={project.slug}>
                  <strong>{project.name}</strong>
                  <span>{project.copy.tagline}</span>
                  <small>{project.stack.join(" · ")}</small>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </Window>
    </main>

    <footer class="desktop-footer">
      <span>© {new Date().getFullYear()} Johannes Grof</span>
      <a href="/impressum/">{t("Legal notice", "Impressum")}</a>
      <a href="/datenschutz/">{t("Privacy", "Datenschutz")}</a>
      <a href={`${prefix}/classic/`}>{t("Reading view", "Leseansicht")}</a>
    </footer>

    <nav class="dock" aria-label={t("Applications", "Anwendungen")}>
      {
        apps.map((app) => (
          <button data-open={app.id} data-dock-app={app.id} aria-label={app.title} title={app.title} class:list={["dock-item", { "is-running": app.id === "welcome" }]}>
            <AppIcon app={app.id} size={54} />
            <span class="dock-tooltip">{app.title}</span>
            <span class="running-dot" />
          </button>
        ))
      }
      <span class="dock-divider"></span>
      <button class="dock-item" data-open="project" data-project="oeffigo" aria-label="ÖffiGo" title="ÖffiGo">
        <img class="app-icon" src="/projects/oeffigo/icon.webp" alt="" width="54" height="54" />
        <span class="dock-tooltip">ÖffiGo</span>
      </button>
      <button class="dock-item" data-open="archive" data-dock-app="archive" aria-label={t("Archive", "Archiv")} title={t("Archive", "Archiv")}>
        <AppIcon app="archive" size={54} />
        <span class="dock-tooltip">{t("Archive", "Archiv")}</span>
        <span class="running-dot" />
      </button>
    </nav>

    <dialog class="spotlight" aria-label={t("Search", "Suchen")}>
      <form method="dialog"><button class="spotlight-close" aria-label={t("Close", "Schließen")}>×</button></form>
      <label class="spotlight-field">
        <Icon name="search" size={26} />
        <input data-spotlight-search type="search" placeholder={t("What are you after?", "Was suchst du?")} aria-label={t("Search", "Suchen")} autocomplete="off" />
      </label>
      <div class="spotlight-results">
        {
          apps.map((app) => (
            <button data-open={app.id} data-spotlight-item={app.title.toLowerCase()}>
              <AppIcon app={app.id} size={21} flat loading="lazy" />
              <span>{app.title}</span>
              <small>App ↵</small>
            </button>
          ))
        }
        {
          projects.map((project) => (
            <button data-open="project" data-project={project.slug} data-spotlight-item={`${project.name} ${project.copy.tagline}`.toLowerCase()}>
              <Icon name="code" size={21} />
              <span>{project.name}</span>
              <small>{t("Project", "Projekt")} ↵</small>
            </button>
          ))
        }
      </div>
      <p data-spotlight-empty hidden>{t("Nothing found.", "Nichts gefunden.")}</p>
    </dialog>

    <div class="desktop-toast" role="status" aria-live="polite" hidden></div>

    <noscript>
      <div class="noscript-desktop">
        {t("The desktop needs JavaScript. The", "Der Desktop braucht JavaScript. Die")}
        <a href={`${prefix}/classic/`}>{t("reading view", "Leseansicht")}</a>
        {t("works without it.", "kommt ohne aus.")}
      </div>
    </noscript>

    <script type="application/json" data-repo-catalogue is:inline set:html={JSON.stringify(repoCatalogue)} />
    <script type="application/json" data-project-index is:inline set:html={JSON.stringify(projectIndex)} />

    <script>
      import "@/scripts/desktop";
    </script>
    <SpeedInsights />
  </body>
</html>

---
import BaseHead from "@/components/BaseHead.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { featuredShowcaseProjects, publicProjects, standardProjects, statusClass, statusLabel, upcomingProjects } from "@/data/projects";
import type { ProjectStatus } from "@/data/projects";
import { getProjectGitHubInfo } from "@/data/github";
import type { LocaleContent } from "@/data/siteContent";
import { defaultSocialImage, toCanonicalUrl } from "@/data/siteMetadata";
import "@/styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  content: LocaleContent;
  canonicalPath: string;
}

const { content, canonicalPath } = Astro.props;
const isDe = content.lang !== "en";

// Build-time live GitHub data for the project cards (stars, latest release,
// total downloads). Falls back gracefully when the API is unavailable.
const githubInfoBySlug = new Map(
  await Promise.all(publicProjects.map(async (project) => [project.slug, await getProjectGitHubInfo(project)] as const))
);

const compactCount = (value: number) =>
  value >= 1000 ? `${(value / 1000).toFixed(value >= 10000 ? 0 : 1).replace(/\.0$/, "")}k` : String(value);

// Small, locale-aware live stat chips shown on each project card.
const liveStats = (slug: string) => {
  const info = githubInfoBySlug.get(slug);
  if (!info) {
    return [];
  }
  const stats: string[] = [];
  if (info.version && info.version.toLowerCase() !== "unreleased") {
    stats.push(/^v/i.test(info.version) ? info.version : `v${info.version}`);
  }
  if (info.stars > 0) {
    stats.push(`★ ${info.stars}`);
  }
  if (info.downloads > 0) {
    stats.push(`↓ ${compactCount(info.downloads)}`);
  }
  return stats;
};

// German labels for the status badge (statusLabel() is English-only).
const statusLabelDe: Record<ProjectStatus, string> = {
  active: "aktiv",
  beta: "beta-release",
  experimental: "aktives experiment",
  preview: "preview",
  "in development": "in entwicklung",
  "coming soon": "bald verfügbar",
  archived: "archiviert",
};
const localizedStatus = (status: ProjectStatus) => (isDe ? statusLabelDe[status] : statusLabel(status));

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");

const terminalProjectRows = publicProjects
  .map((project, index) => {
    const branch = index === publicProjects.length - 1 ? "└" : "├";
    return `│  ${branch}─ <a class="terminal-link" href="/projects/${project.slug}/">${escapeHtml(project.name)}</a>`;
  })
  .join("\n");
const terminalUpcomingRows = upcomingProjects
  .map((project, index) => {
    const branch = index === upcomingProjects.length - 1 ? "└" : "├";
    return `│        ${branch}─ ${escapeHtml(project.name)}`;
  })
  .join("\n");
const terminalTreeHtml = `<span class="path">/home/johannes_grof/</span>
├─ <span class="folder">my_links/</span>
│  ├─ <a class="link terminal-link" href="https://github.com/jx-grxf" target="_blank" rel="noreferrer" aria-label="Open GitHub profile">github</a>
│  ├─ <a class="link terminal-link" href="https://www.linkedin.com/in/johannes-grof" target="_blank" rel="noreferrer" aria-label="Open LinkedIn profile">linkedin</a>
│  └─ <a class="link terminal-link" href="mailto:contact@johannesgrof.me" aria-label="Send an email to Johannes Grof">email</a>
├─ <a class="folder terminal-link" href="#projects">projects/</a>
${terminalProjectRows}
│     └─ <span class="folder">coming-soon/</span>
${terminalUpcomingRows}
├─ <a class="folder terminal-link" href="#skills">skills/</a>
│  ├─ TypeScript
│  ├─ Swift
│  └─ Codex
├─ <a class="folder terminal-link" href="#services">services/</a>
│  └─ websites-and-tools
└─ <span class="folder">contact/</span>
   └─ <a class="link terminal-link" href="mailto:contact@johannesgrof.me" aria-label="Send an email to Johannes Grof">contact@johannesgrof.me</a>`;

const hreflangAlternates = [
  { hreflang: "en", href: toCanonicalUrl("/") },
  { hreflang: "de-AT", href: toCanonicalUrl("/de/") },
  { hreflang: "x-default", href: toCanonicalUrl("/") },
];

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "Johannes Grof",
  url: toCanonicalUrl(canonicalPath),
  inLanguage: content.lang,
  description: content.meta.description,
  mainEntity: {
    "@type": "Person",
    name: "Johannes Grof",
    jobTitle: "Software Developer (Student)",
    description: content.meta.description,
    nationality: "Austrian",
    address: {
      "@type": "PostalAddress",
      addressRegion: "Styria",
      addressCountry: "AT",
    },
    url: toCanonicalUrl("/"),
    email: "contact@johannesgrof.me",
    sameAs: [
      "https://github.com/jx-grxf",
      "https://www.linkedin.com/in/johannes-grof",
      "https://x.com/jx_grxf",
    ],
    affiliation: {
      "@type": "EducationalOrganization",
      name: "HTL Kaindorf",
      url: "https://www.htl-kaindorf.at/",
    },
    knowsAbout: ["TypeScript", "Swift", "Python", "Astro", "macOS apps", "AI automation", "developer tools", "web development", "web hosting", "domain management", "website maintenance", "electronics repair", "technical support"],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: content.lang,
  mainEntity: content.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

// Ties the website to the Google Business Profile (same name and area).
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${toCanonicalUrl("/")}#business`,
  name: "Johannes Grof IT",
  image: toCanonicalUrl(defaultSocialImage),
  url: toCanonicalUrl("/"),
  email: "contact@johannesgrof.me",
  description: content.meta.description,
  founder: {
    "@type": "Person",
    name: "Johannes Grof",
  },
  address: {
    "@type": "PostalAddress",
    addressRegion: "Steiermark",
    addressCountry: "AT",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Südoststeiermark" },
    { "@type": "AdministrativeArea", name: "Steiermark" },
  ],
  sameAs: [
    "https://github.com/jx-grxf",
    "https://www.linkedin.com/in/johannes-grof",
    "https://x.com/jx_grxf",
  ],
  knowsAbout: ["website development", "web hosting", "domain management", "website maintenance", "technical support", "computer setup", "electronics help", "custom software"],
};
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <BaseHead
      title={content.meta.title}
      description={content.meta.description}
      canonicalPath={canonicalPath}
      ogLocale={content.ogLocale}
      hreflangAlternates={hreflangAlternates}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profileSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body>
    <SiteHeader navItems={content.nav} homeHref={canonicalPath} langSwitch={content.langSwitch} />

    <main>
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">{content.hero.eyebrow}</p>
          <h1 id="hero-title">{content.hero.title}</h1>
          <p class="hero-text">{content.hero.body}</p>
          <p class="hero-proof">{publicProjects.length} {content.lang === "en" ? "public projects" : "öffentliche Projekte"} · {content.hero.proof}</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">{content.hero.primaryAction}</a>
            <a class="button secondary" href="#services">{content.hero.secondaryAction}</a>
            <a class="button secondary" href="#contact">{content.hero.contactAction}</a>
            <a class="button secondary icon-button" href="https://github.com/jx-grxf" target="_blank" rel="noreferrer" aria-label="Johannes Grof on GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.95c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.95.68 1.92v2.85c0 .27.18.59.69.49A10.05 10.05 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"
                />
              </svg>
              {content.hero.githubAction}
            </a>
          </div>
        </div>

        <aside class="terminal-card" aria-label="Developer profile tree">
          <div class="terminal-bar">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <pre><code set:html={terminalTreeHtml}></code></pre>
        </aside>
      </section>

      <section id="projects" class="section-shell">
        <div class="section-heading reveal">
          <p class="eyebrow">{isDe ? "ausgewählte arbeit" : "selected work"}</p>
          <h2>{content.lang === "en" ? "Featured Projects" : "Ausgewählte Projekte"}</h2>
        </div>
        <div class="featured-project-grid">
          {
            featuredShowcaseProjects.map((project, index) => {
              const heroImage = project.showcase[0];
              const cardImageSrc = heroImage?.cardSrc ?? heroImage?.src;

              return (
                <a class="project-card featured-project-card reveal" style={`--reveal-delay: ${index * 80}ms`} href={`/projects/${project.slug}/`}>
                  <div class="featured-card-media">
                    {cardImageSrc ? (
                      <picture>
                        <source srcset={cardImageSrc} type="image/webp" />
                        <img class="featured-card-image" src={cardImageSrc} alt={heroImage.alt} width={heroImage.width} height={heroImage.height} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                      </picture>
                    ) : (
                      <div class="featured-card-placeholder" aria-hidden="true">
                        <span class="featured-card-placeholder-mark">{project.name}</span>
                        <span class="featured-card-placeholder-tagline">{project.tagline}</span>
                      </div>
                    )}
                    {project.logo && (
                      <picture>
                        {project.logo.fallbackSrc && <source srcset={project.logo.src} type="image/webp" />}
                        <img class="featured-card-logo" src={project.logo.fallbackSrc ?? project.logo.src} alt="" width={project.logo.width} height={project.logo.height} aria-hidden="true" loading="lazy" decoding="async" />
                      </picture>
                    )}
                  </div>
                  <div class="featured-card-body">
                    <div class="card-topline">
                      <h3>{project.name}</h3>
                      <span class={`status ${statusClass(project.status)}`}>{localizedStatus(project.status)}</span>
                    </div>
                    {liveStats(project.slug).length > 0 && (
                      <ul class="live-stats" aria-label={`${project.name} GitHub stats`}>
                        {liveStats(project.slug).map((stat) => <li>{stat}</li>)}
                      </ul>
                    )}
                    {project.proofLabels && (
                      <ul class="proof-chip-list" aria-label={`${project.name} proof points`}>
                        {project.proofLabels.map((label) => <li>{label}</li>)}
                      </ul>
                    )}
                    <p>{project.description}</p>
                    <p class="project-result">{project.result}</p>
                    <ul>
                      {project.stack.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                </a>
              );
            })
          }
        </div>

        <div class="section-heading project-subheading reveal">
          <p class="eyebrow">{isDe ? "weitere projekte" : "more projects"}</p>
          <h2>{content.lang === "en" ? "Projects" : "Projekte"}</h2>
        </div>
        <div class="project-grid">
          {
            standardProjects.map((project, index) => (
              <a class="project-card reveal" style={`--reveal-delay: ${index * 70}ms`} href={`/projects/${project.slug}/`}>
                    <div class="card-topline">
                      <h3>{project.name}</h3>
                      <span class={`status ${statusClass(project.status)}`}>{localizedStatus(project.status)}</span>
                    </div>
                  {liveStats(project.slug).length > 0 && (
                    <ul class="live-stats" aria-label={`${project.name} GitHub stats`}>
                      {liveStats(project.slug).map((stat) => <li>{stat}</li>)}
                    </ul>
                  )}
                  {project.proofLabels && (
                    <ul class="proof-chip-list" aria-label={`${project.name} proof points`}>
                      {project.proofLabels.map((label) => <li>{label}</li>)}
                    </ul>
                  )}
                  <p>{project.description}</p>
                  <p class="project-audience">{project.audience}</p>
                  <p class="project-result">{project.result}</p>
                  <ul>
                    {project.stack.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </a>
            ))
          }
        </div>
        <div class="coming-soon-group reveal" aria-labelledby="coming-soon-title">
          <h3 id="coming-soon-title">{isDe ? "bald verfügbar" : "coming soon"}</h3>
          <div class="upcoming-list">
            {
              upcomingProjects.map((project, index) => (
                <article class="upcoming-project reveal" style={`--reveal-delay: ${index * 70}ms`}>
                  <div>
                    <h4>{project.name}</h4>
                    <p>{project.description}</p>
                  </div>
                  <span class={`status ${statusClass(project.status)}`}>{localizedStatus(project.status)}</span>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="skills" class="section-shell skills-section reveal">
        <div class="section-heading">
          <p class="eyebrow">{content.skills.eyebrow}</p>
          <h2>{content.skills.title}</h2>
        </div>
        <div class="skills-grid">
          {
            content.skills.groups.map((group, index) => (
              <article class="skill-group" style={`--reveal-delay: ${index * 70}ms`}>
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="services" class="services-band">
        <div class="section-shell services-layout reveal">
          <div class="services-intro">
            <p class="eyebrow">{content.services.eyebrow}</p>
            <h2>{content.services.title}</h2>
            <p class="services-lead">{content.services.lead}</p>
          </div>
          <ul class="service-list">
            {
              content.services.items.map((service) => (
                <li class="service-item">
                  <h3>{service.title}</h3>
                  <p>{service.body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="faq" class="section-shell faq-section reveal">
        <div class="section-heading">
          <p class="eyebrow">{content.faq.eyebrow}</p>
          <h2>{content.faq.title}</h2>
        </div>
        <div class="faq-list">
          {
            content.faq.items.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <div class="faq-answer">
                  <div>
                    <p>{item.a}</p>
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <section id="about" class="section-shell split-section reveal">
        <div>
          <p class="eyebrow">{content.about.eyebrow}</p>
          <h2>{content.about.title}</h2>
        </div>
        <p>{content.about.body}</p>
      </section>

      <section id="contact" class="section-shell contact-section reveal">
        <div>
          <p class="eyebrow">{content.contact.eyebrow}</p>
          <h2>{content.contact.title}</h2>
          <p class="contact-note">{content.contact.note}</p>
        </div>
        <div class="contact-panel">
        <form class="contact-form" id="contact-form" novalidate>
          <div class="contact-field">
            <label for="contact-name">{content.contact.form.nameLabel}</label>
            <input type="text" id="contact-name" name="name" autocomplete="name" maxlength="120" placeholder={content.contact.form.namePlaceholder} required />
          </div>
          <div class="contact-field">
            <label for="contact-email">{content.contact.form.emailLabel}</label>
            <input type="email" id="contact-email" name="email" autocomplete="email" maxlength="320" placeholder={content.contact.form.emailPlaceholder} required />
          </div>
          <div class="contact-field">
            <label for="contact-message">{content.contact.form.messageLabel}</label>
            <textarea id="contact-message" name="message" rows="4" maxlength="5000" placeholder={content.contact.form.messagePlaceholder} required></textarea>
          </div>
          <input type="text" name="company" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="contact-submit" data-label={content.contact.form.submit} data-sending={content.contact.form.sending}>{content.contact.form.submit}</button>
          <p class="contact-status" role="status" aria-live="polite" data-success={content.contact.form.success} data-error={content.contact.form.error} data-rate-limited={content.contact.form.rateLimited}></p>
          <p class="contact-privacy-note">
            {content.lang === "en" ? "By sending you agree to the " : "Mit dem Absenden stimmst du der "}
            <a href="/datenschutz/">{content.lang === "en" ? "privacy policy" : "Datenschutzerklärung"}</a>{content.lang === "en" ? "." : " zu."}
          </p>
        </form>
        <div class="contact-actions">
          <a class="contact-btn contact-btn--email contact-btn--icon-only" href="mailto:contact@johannesgrof.me" aria-label="E-Mail">
            <svg class="contact-btn-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </a>
          <a class="contact-btn contact-btn--github contact-btn--icon-only" href="https://github.com/jx-grxf" target="_blank" rel="noreferrer" aria-label="GitHub">
            <svg class="contact-btn-icon" viewBox="0 -0.5 25 25" width="20" height="20" aria-hidden="true" fill="currentColor">
              <path d="m12.301 0h.093c2.242 0 4.34.613 6.137 1.68l-.055-.031c1.871 1.094 3.386 2.609 4.449 4.422l.031.058c1.04 1.769 1.654 3.896 1.654 6.166 0 5.406-3.483 10-8.327 11.658l-.087.026c-.063.02-.135.031-.209.031-.162 0-.312-.054-.433-.144l.002.001c-.128-.115-.208-.281-.208-.466 0-.005 0-.01 0-.014v.001q0-.048.008-1.226t.008-2.154c.007-.075.011-.161.011-.249 0-.792-.323-1.508-.844-2.025.618-.061 1.176-.163 1.718-.305l-.076.017c.573-.16 1.073-.373 1.537-.642l-.031.017c.508-.28.938-.636 1.292-1.058l.006-.007c.372-.476.663-1.036.84-1.645l.009-.035c.209-.683.329-1.468.329-2.281 0-.045 0-.091-.001-.136v.007c0-.022.001-.047.001-.072 0-1.248-.482-2.383-1.269-3.23l.003.003c.168-.44.265-.948.265-1.479 0-.649-.145-1.263-.404-1.814l.011.026c-.115-.022-.246-.035-.381-.035-.334 0-.649.078-.929.216l.012-.005c-.568.21-1.054.448-1.512.726l.038-.022-.609.384c-.922-.264-1.981-.416-3.075-.416s-2.153.152-3.157.436l.081-.02q-.256-.176-.681-.433c-.373-.214-.814-.421-1.272-.595l-.066-.022c-.293-.154-.64-.244-1.009-.244-.124 0-.246.01-.364.03l.013-.002c-.248.524-.393 1.139-.393 1.788 0 .531.097 1.04.275 1.509l-.01-.029c-.785.844-1.266 1.979-1.266 3.227 0 .025 0 .051.001.076v-.004c-.001.039-.001.084-.001.13 0 .809.12 1.591.344 2.327l-.015-.057c.189.643.476 1.202.85 1.693l-.009-.013c.354.435.782.793 1.267 1.062l.022.011c.432.252.933.465 1.46.614l.046.011c.466.125 1.024.227 1.595.284l.046.004c-.431.428-.718 1-.784 1.638l-.001.012c-.207.101-.448.183-.699.236l-.021.004c-.256.051-.549.08-.85.08-.022 0-.044 0-.066 0h.003c-.394-.008-.756-.136-1.055-.348l.006.004c-.371-.259-.671-.595-.881-.986l-.007-.015c-.198-.336-.459-.614-.768-.827l-.009-.006c-.225-.169-.49-.301-.776-.38l-.016-.004-.32-.048c-.023-.002-.05-.003-.077-.003-.14 0-.273.028-.394.077l.007-.003q-.128.072-.08.184c.039.086.087.16.145.225l-.001-.001c.061.072.13.135.205.19l.003.002.112.08c.283.148.516.354.693.603l.004.006c.191.237.359.505.494.792l.01.024.16.368c.135.402.38.738.7.981l.005.004c.3.234.662.402 1.057.478l.016.002c.33.064.714.104 1.106.112h.007c.045.002.097.002.15.002.261 0 .517-.021.767-.062l-.027.004.368-.064q0 .609.008 1.418t.008.873v.014c0 .185-.08.351-.208.466h-.001c-.119.089-.268.143-.431.143-.075 0-.147-.011-.214-.032l.005.001c-4.929-1.689-8.409-6.283-8.409-11.69 0-2.268.612-4.393 1.681-6.219l-.032.058c1.094-1.871 2.609-3.386 4.422-4.449l.058-.031c1.739-1.034 3.835-1.645 6.073-1.645h.098-.005z" />
            </svg>
          </a>
          <a class="contact-btn contact-btn--linkedin contact-btn--icon-only" href="https://www.linkedin.com/in/johannes-grof" target="_blank" rel="noreferrer" aria-label="LinkedIn">
            <svg class="contact-btn-icon" viewBox="0 0 382 382" width="20" height="20" aria-hidden="true" fill="currentColor">

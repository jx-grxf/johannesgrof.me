---
import ContactForm from "@/components/ContactForm.astro";
import BaseHead from "@/components/BaseHead.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import PixelSprite from "@/components/PixelSprite.astro";
import { getProjectCopy, homepageProjects, projectsBySlug, publicProjects, localizedStatusLabel, statusClass } from "@/data/projects";
import { getProjectGitHubInfo } from "@/data/github";
import { departureStops } from "@/lib/departures";
import type { ProjectLang } from "@/data/projects";
import { oeffigo } from "@/data/oeffigo";
import { kontobuch } from "@/data/kontobuch";
import type { LocaleContent } from "@/data/siteContent";
import { personSameAs, toCanonicalUrl } from "@/data/siteMetadata";
import "@/styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  content: LocaleContent;
  canonicalPath: string;
}

const { content, canonicalPath } = Astro.props;
const isDe = content.lang !== "en";
const lang: ProjectLang = isDe ? "de" : "en";
const localePrefix = isDe ? "/de" : "";

// The most recently pushed public repo, read from GitHub at build time. Without
// live data the item is simply left out instead of showing a stale date.
const pushes = await Promise.all(
  publicProjects
    .filter((project) => project.visibility === "public")
    .map(async (project) => ({ project, info: await getProjectGitHubInfo(project) })),
);
const latestPush = pushes
  .filter(({ info }) => info.metadataState !== "fallback" && info.updatedAt)
  .sort((a, b) => b.info.updatedAt.localeCompare(a.info.updatedAt))[0];
const latestPushDate = latestPush
  ? new Intl.DateTimeFormat(isDe ? "de-AT" : "en-GB", { day: "numeric", month: "short", timeZone: "Europe/Vienna" }).format(new Date(latestPush.info.updatedAt))
  : "";

// Stack proof links: the two products have their own pages, everything else is
// a catalogue entry.
const proofLink = (slug: string) => {
  if (slug === "oeffigo") return { name: "ÖffiGo", href: `${localePrefix}/oeffigo/` };
  if (slug === "kontobuch") return { name: "Kontobuch", href: kontobuch.websiteUrl };
  const project = projectsBySlug.get(slug);
  return project ? { name: project.name, href: `${localePrefix}/projects/${project.slug}/` } : undefined;
};

const monogram = (name: string) => name.replace(/[^A-Za-zÄÖÜäöü]/g, "").slice(0, 2);

// Split the headline around its accent word here rather than in the template:
// interpolating three expressions across separate JSX lines re-introduces the
// whitespace that would show up as a gap before the following punctuation.
const accentWord = content.hero.titleAccent;
const accentAt = accentWord ? content.hero.title.indexOf(accentWord) : -1;
const titleLead = accentAt >= 0 ? content.hero.title.slice(0, accentAt) : content.hero.title;
const titleAccent = accentAt >= 0 && accentWord ? accentWord : "";
const titleTail = accentAt >= 0 && accentWord ? content.hero.title.slice(accentAt + accentWord.length) : "";
// The pixel terminal sits after the first word of the headline.
const firstBreak = titleLead.indexOf(" ");
const titleFirst = firstBreak > 0 ? titleLead.slice(0, firstBreak) : titleLead;
const titleRest = firstBreak > 0 ? titleLead.slice(firstBreak) : "";

const hreflangAlternates = [
  { hreflang: "en", href: toCanonicalUrl("/") },
  { hreflang: "de-AT", href: toCanonicalUrl("/de/") },
  { hreflang: "x-default", href: toCanonicalUrl("/") },
];

const kontobuchSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${kontobuch.websiteUrl}#app`,
  name: kontobuch.name,
  url: kontobuch.websiteUrl,
  description: kontobuch.description[lang],
  image: toCanonicalUrl(kontobuch.icon),
  applicationCategory: "EducationalApplication",
  operatingSystem: "macOS, Windows, Linux, Web",
  inLanguage: "de-AT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  creator: { "@id": toCanonicalUrl("/#person") },
};

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "Johannes Grof",
  url: toCanonicalUrl(canonicalPath),
  inLanguage: content.lang,
  description: content.meta.description,
  mentions: { "@id": kontobuchSchema["@id"] },
  mainEntity: {
    "@type": "Person",
    "@id": toCanonicalUrl("/#person"),
    name: "Johannes Grof",
    jobTitle: "Software Developer (Student)",
    description: content.meta.description,
    nationality: "Austrian",
    address: {
      "@type": "PostalAddress",
      addressRegion: "Styria",
      addressCountry: "AT",
    },
    url: toCanonicalUrl("/"),
    email: "contact@johannesgrof.me",
    sameAs: personSameAs,
    affiliation: {
      "@type": "EducationalOrganization",
      name: "HTL Kaindorf",
      url: "https://www.htl-kaindorf.at/",
    },
    knowsAbout: ["TypeScript", "Swift", "Python", "Rust", "Astro", "iOS apps", "macOS apps", "developer tools", "web development", "automation"],
  },
};

---

<!doctype html>
<html lang={content.lang}>
  <head>
    <BaseHead
      title={content.meta.title}
      description={content.meta.description}
      canonicalPath={canonicalPath}
      ogLocale={content.ogLocale}
      hreflangAlternates={hreflangAlternates}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profileSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(kontobuchSchema)} />
  </head>
  <body>
    <SiteHeader ariaLabel={isDe ? "Hauptnavigation" : "Primary navigation"} navItems={content.nav} homeHref={canonicalPath} langSwitch={content.langSwitch} lang={isDe ? "de" : "en"} />

    <main id="main">
      <section class="hero-stage" aria-labelledby="hero-title">
        <div class="hero section-shell">
          <p class="eyebrow">{content.hero.eyebrow}</p>
          <h1 id="hero-title">{titleFirst}<button class="hero-glyph" type="button" data-terminal-open aria-label={isDe ? "Terminal öffnen" : "Open the terminal"} title={isDe ? "Terminal öffnen (~)" : "Open the terminal (~)"}><PixelSprite name="terminal" /></button>{titleRest}<span class="display-em">{titleAccent}</span>{titleTail}</h1>
          <p class="hero-text">{content.hero.body}</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">{content.hero.primaryAction}</a>
            <a class="button secondary" href="#contact">{content.hero.contactAction}</a>
          </div>
        </div>

        {/* The margins outside the frame: stacked blocks with a sprite on top. */}
        <div class="hero-edge hero-edge--left" aria-hidden="true">
          <span class="edge-block edge-step-3 edge-ink">
            <span class="edge-sprite egg-swap" data-egg="mac"><PixelSprite name="mac" class="egg-a" /><PixelSprite name="happymac" class="egg-b" /></span>
          </span>
          <span class="edge-block edge-step-2 edge-amber"></span>
          <span class="edge-block edge-step-1 edge-signal"></span>
        </div>
        <div class="hero-edge hero-edge--right" aria-hidden="true">
          <span class="edge-block edge-step-3 edge-amber">
            <span class="edge-sprite egg-swap" data-egg="pumpkin"><PixelSprite name="pumpkin" class="egg-a" /><PixelSprite name="oil" class="egg-b" /></span>
          </span>
          <span class="edge-block edge-step-2 edge-ink"></span>
          <span class="edge-block edge-step-1 edge-signal edge-tall"></span>
        </div>

        {/* Only after dark in Styria (see scripts/scene.ts). */}
        <div class="hero-stars" aria-hidden="true">
          {[[3, 18], [7, 34], [5, 52], [94, 22], [97, 40], [95, 58], [2, 70], [93, 74]].map(([x, y], i) => (
            <span style={`left:${x}%;top:${y}%;animation-delay:${(i * 0.37).toFixed(2)}s`}><PixelSprite name="star" /></span>
          ))}
        </div>

        {/* The hero's bottom rule is a track. */}
        <div class="hero-track">
          <a class="hero-train" href="#oeffigo" aria-label={isDe ? "Zu ÖffiGo" : "Go to ÖffiGo"}>
            <span class="hero-train-sign" aria-hidden="true">ÖffiGo · {isDe ? "Beta" : "beta"}</span>
            <PixelSprite name="train" />
          </a>
        </div>
      </section>

      <div class="status-row">
        <dl class="hero-status section-shell">
          <div><dt>{content.hero.status.now}</dt><dd><a href="#oeffigo"><span class="status-dot" aria-hidden="true"></span>{content.hero.status.nowValue}</a></dd></div>
          {latestPush && (
            <div><dt>{content.hero.status.push}</dt><dd><a href={`${localePrefix}/projects/${latestPush.project.slug}/`}>{latestPush.project.name}</a> <span class="hero-status-meta">{latestPushDate}</span></dd></div>
          )}
          <div><dt>{content.hero.status.stack}</dt><dd><a href="#services">{content.hero.status.stackValue}</a></dd></div>
          <div class="hero-status-clock" data-clock hidden><dt>{content.hero.status.clock}</dt><dd><time data-clock-time></time> <span class="hero-status-meta">{isDe ? "Steiermark" : "Styria"}</span></dd></div>
        </dl>
      </div>

      <div id="projects">
        <section id="oeffigo" class="oeffigo-band" aria-labelledby="oeffigo-title">
          <div class="section-shell">
            <div class="section-head"><span class="section-num">01</span><h2>{content.oeffigo.eyebrow}</h2></div>
            <div class="featured-product featured-product--phone">
              <div class="featured-product-copy">
                <div class="product-heading"><img src={oeffigo.icon} alt="" width="64" height="64" loading="lazy" /><h2 id="oeffigo-title">ÖffiGo</h2></div>
                <p class="product-tagline">{oeffigo.tagline[lang]}</p>
                <p>{isDe ? "ÖffiGo ist mein größtes Projekt: eine Öffi-App für Österreich. Sie zeigt Abfahrten, findet Verbindungen und begleitet dich am iPhone und an der Apple Watch. An jeder Zeit steht, ob sie vom Betreiber kommt, berechnet ist oder nur im Fahrplan steht." : "ÖffiGo is my largest project: a public transport app for Austria. It shows departures, plans journeys and follows your trip on iPhone and Apple Watch. Each time tells you whether it comes from the operator, is calculated or is just the timetable."}</p>
                <p class="product-availability">{oeffigo.status[lang]}</p>
                <div class="oeffigo-actions"><a class="button primary" href={`${localePrefix}/oeffigo/`}>{content.oeffigo.detailCta}</a><a class="button secondary" href={oeffigo.websiteUrl}>oeffigo.app ↗</a></div>
                <p class="product-footnote"><a href={oeffigo.liveUrl}>{isDe ? "Pünktlichkeit nachschauen" : "Explore punctuality"} ↗</a><a href={oeffigo.statusUrl}>{isDe ? "Systemstatus" : "System status"} ↗</a></p>
              </div>
              <figure class="product-phone-preview"><img src={oeffigo.shots[0].src} alt={oeffigo.shots[0].alt[lang]} width="675" height="1380" loading="lazy" decoding="async" /><figcaption>{isDe ? "Die Heute-Ansicht am iPhone. Screenshot aus der Beta." : "Today on iPhone. Screenshot from the beta."}</figcaption></figure>
            </div>

            {/* Live departures from Wiener Linien open data, the way ÖffiGo
                reads a station board. Filled by scripts/departures.ts. */}
            <section class="dep-board" data-departures data-state="idle" aria-labelledby="dep-title">
              <div class="dep-head">
                <h3 id="dep-title"><span class="status-dot" aria-hidden="true"></span>{isDe ? "Gerade in Wien" : "Right now in Vienna"}</h3>
                <div class="dep-stops" role="group" aria-label={isDe ? "Haltestelle wählen" : "Choose a stop"}>
                  {departureStops.map((stop, i) => (
                    <button type="button" data-stop={stop.slug} aria-pressed={i === 0 ? "true" : "false"}>{stop.name}</button>
                  ))}
                </div>
              </div>
              <div class="led-board dep-led">
                <div class="led-top"><span>{isDe ? "Abfahrten" : "Departures"}</span><span data-departures-clock>--:--</span></div>
                <ul class="dep-rows" data-departures-rows aria-live="polite"></ul>
                <p class="dep-status" data-departures-status>{isDe ? "Lade Abfahrten …" : "Loading departures …"}</p>
              </div>
              <p class="dep-note">
                {isDe
                  ? "Echtzeit heißt: Die Zeit kommt vom Betreiber. Fahrplan heißt: Für diese Fahrt liefert niemand Echtzeit. Datenquelle: Stadt Wien – data.wien.gv.at (CC BY 4.0)."
                  : "Real time means the operator supplied the time. Timetable means nobody supplies real time for that trip. Data source: City of Vienna – data.wien.gv.at (CC BY 4.0)."}
                {" "}<a href={oeffigo.websiteUrl}>{isDe ? "Mehr davon in ÖffiGo" : "More of this in ÖffiGo"} ↗</a>
              </p>
            </section>
          </div>
        </section>
        <section id="kontobuch" class="band section-shell" aria-labelledby="kontobuch-title">
          <div class="section-head"><span class="section-num">02</span><h2>{isDe ? "Für die Schule" : "For school"}</h2></div>
          <div class="featured-product featured-product--notebook">
            <div class="featured-product-copy">
              <div class="product-heading"><img src={kontobuch.icon} alt="" width="64" height="64" loading="lazy" /><h2 id="kontobuch-title">Kontobuch</h2></div>
              <p class="product-tagline">{isDe ? "Rechnungswesen, wie im Heft." : "Accounting, like a notebook."}</p>
              <p>{kontobuch.description[lang]}</p>
              <p>{isDe ? "Gebaut für HAK und HTL. Du kannst direkt im Browser anfangen oder die App installieren. Deine Hefte bleiben bei dir." : "Built for HAK and HTL students. Start in your browser or install the app. Your notebooks stay with you."}</p>
              <p class="product-availability">{kontobuch.availability[lang]}</p>
              <div class="oeffigo-actions"><a class="button primary" href={kontobuch.websiteUrl}>{kontobuch.websiteLabel[lang]} ↗</a></div>
            </div>
            <figure class="product-notebook-preview"><a href={kontobuch.websiteUrl} aria-label={isDe ? "Kontobuch ansehen" : "Explore Kontobuch"}><span class="mac-window-bar" aria-hidden="true"><span class="tl"></span><span class="tl"></span><span class="tl"></span><strong>kontobuch.johannesgrof.me</strong></span><img src="/projects/kontobuch/notebook.jpg" alt={isDe ? "Kontobuch im Browser mit Heftseite, Beispielgeschäftsfall und Werkzeugen für T-Konten." : "Kontobuch in the browser, with a notebook page, an example transaction and T-account tools."} width="1280" height="850" loading="lazy" decoding="async" /></a><figcaption>{isDe ? "Eine Heftseite in der Web-App. Auf der Website kannst du selbst ausprobieren." : "A notebook page in the web app. Try it yourself on the website."}</figcaption></figure>
          </div>
        </section>
        <section class="band section-shell" aria-labelledby="selected-projects-title">
          <div class="section-head"><span class="section-num">03</span><h2 id="selected-projects-title">{content.more.title}</h2></div>
          <ul class="work-index">
            {homepageProjects.map((project) => (
              <li>
                <a href={`${localePrefix}/projects/${project.slug}/`}>
                  {project.logo
                    ? <img class="work-index-icon" src={project.logo.src} alt="" width="48" height="48" loading="lazy" decoding="async" />
                    : <span class="work-index-icon work-index-icon--mono" aria-hidden="true">{monogram(project.name)}</span>}
                  <span class="work-index-name"><strong>{project.name}</strong><span>{getProjectCopy(project, lang).tagline}</span></span>
                  <span class="work-index-stack">{project.stack.join(" · ")}</span>
                  <span class={`status ${statusClass(project.status)}`}>{localizedStatusLabel(project.status, lang)}</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="catalogue-cta"><p>{content.more.catalogue}</p><a class="button secondary" href={`${localePrefix}/projects/`}>{content.more.catalogueAction} <span aria-hidden="true">↗</span></a></div>
        </section>
      </div>

      {/* #services and #skills are both older anchors that are still linked
          from outside; the stack band answers both. */}
      <section id="services" class="band band--tint" aria-labelledby="stack-title">
        <div class="section-shell">
          <div class="section-head">
            <span class="section-num">04</span>
            <h2 id="stack-title">{content.stack.title}</h2>
          </div>
          <p class="services-lead">{content.stack.lead}</p>
          <div id="skills" class="stack-grid">
            {content.stack.groups.map((group) => (
              <article class="stack-group">
                <h3>{group.title}</h3>
                <ul class="stack-items">{group.items.map((item) => <li>{item}</li>)}</ul>
                <p class="stack-proof">
                  <span>{content.stack.proofLabel}</span>
                  {group.proof.map(proofLink).filter((link) => link !== undefined).map((link) => <a href={link.href}>{link.name}</a>)}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="band section-shell split-section" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">{content.about.eyebrow}</p>
          <h2 id="about-title">{content.about.title}</h2>
        </div>
        <p>{content.about.body}</p>
      </section>

      <section id="contact" class="band section-shell contact-section" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow">{content.contact.eyebrow}</p>
          <h2 id="contact-title">{content.contact.title}</h2>
          <p class="contact-note">{content.contact.note}</p>
          <p class="contact-note">
            <a class="text-link" href="mailto:contact@johannesgrof.me">contact@johannesgrof.me</a>
          </p>
          <p class="eyebrow contact-elsewhere">{content.contact.elsewhere}</p>
          <SocialLinks variant="cards" />
        </div>

        <ContactForm content={content.contact.form} lang={isDe ? "de" : "en"} />
      </section>
    </main>

    <SiteFooter lang={isDe ? "de" : "en"} />

    <SpeedInsights />
    <script>
      import "@/scripts/clock";
      import "@/scripts/scene";
      import "@/scripts/departures";
    </script>
  </body>
</html>

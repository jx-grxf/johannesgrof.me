---
import ContactForm from "@/components/ContactForm.astro";
import BaseHead from "@/components/BaseHead.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import ProjectPreview from "@/components/ProjectPreview.astro";
import { getProjectCopy, homepageProjects, homepageSmallProjects, localizedStatusLabel, statusClass } from "@/data/projects";
import type { ProjectLang } from "@/data/projects";
import { oeffigo } from "@/data/oeffigo";
import { kontobuch } from "@/data/kontobuch";
import type { LocaleContent } from "@/data/siteContent";
import { personSameAs, toCanonicalUrl } from "@/data/siteMetadata";
import "@/styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  content: LocaleContent;
  canonicalPath: string;
}

const { content, canonicalPath } = Astro.props;
const isDe = content.lang !== "en";
const lang: ProjectLang = isDe ? "de" : "en";
const localePrefix = isDe ? "/de" : "";

const selectedProjects = homepageProjects;
const smallerProjects = homepageSmallProjects;

// Split the headline around its accent word here rather than in the template:
// interpolating three expressions across separate JSX lines re-introduces the
// whitespace that would show up as a gap before the following punctuation.
const accentWord = content.hero.titleAccent;
const accentAt = accentWord ? content.hero.title.indexOf(accentWord) : -1;
const titleLead = accentAt >= 0 ? content.hero.title.slice(0, accentAt) : content.hero.title;
const titleAccent = accentAt >= 0 && accentWord ? accentWord : "";
const titleTail = accentAt >= 0 && accentWord ? content.hero.title.slice(accentAt + accentWord.length) : "";

const hreflangAlternates = [
  { hreflang: "en", href: toCanonicalUrl("/") },
  { hreflang: "de-AT", href: toCanonicalUrl("/de/") },
  { hreflang: "x-default", href: toCanonicalUrl("/") },
];

const kontobuchSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${kontobuch.websiteUrl}#app`,
  name: kontobuch.name,
  url: kontobuch.websiteUrl,
  description: kontobuch.description[lang],
  image: toCanonicalUrl(kontobuch.icon),
  applicationCategory: "EducationalApplication",
  operatingSystem: "macOS, Windows, Linux, Web",
  inLanguage: "de-AT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  creator: { "@id": toCanonicalUrl("/#person") },
};

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "Johannes Grof",
  url: toCanonicalUrl(canonicalPath),
  inLanguage: content.lang,
  description: content.meta.description,
  mentions: { "@id": kontobuchSchema["@id"] },
  mainEntity: {
    "@type": "Person",
    "@id": toCanonicalUrl("/#person"),
    name: "Johannes Grof",
    jobTitle: "Software Developer (Student)",
    description: content.meta.description,
    nationality: "Austrian",
    address: {
      "@type": "PostalAddress",
      addressRegion: "Styria",
      addressCountry: "AT",
    },
    url: toCanonicalUrl("/"),
    email: "contact@johannesgrof.me",
    sameAs: personSameAs,
    affiliation: {
      "@type": "EducationalOrganization",
      name: "HTL Kaindorf",
      url: "https://www.htl-kaindorf.at/",
    },
    knowsAbout: ["TypeScript", "Swift", "Python", "Astro", "macOS apps", "developer tools", "web development", "web hosting", "domain management", "website maintenance", "electronics repair", "technical support"],
  },
};

---

<!doctype html>
<html lang={content.lang}>
  <head>
    <BaseHead
      title={content.meta.title}
      description={content.meta.description}
      canonicalPath={canonicalPath}
      ogLocale={content.ogLocale}
      hreflangAlternates={hreflangAlternates}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profileSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(kontobuchSchema)} />
  </head>
  <body>
    <SiteHeader ariaLabel={isDe ? "Hauptnavigation" : "Primary navigation"} navItems={content.nav} homeHref={canonicalPath} langSwitch={content.langSwitch} lang={isDe ? "de" : "en"} />

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title">{titleLead}<span class="display-em">{titleAccent}</span>{titleTail}</h1>
        <p class="hero-text">{content.hero.body}</p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">{content.hero.primaryAction}</a>
          <a class="button secondary" href="#contact">{content.hero.contactAction}</a>
        </div>
        <ul class="hero-facts">
          {content.hero.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </section>

      <div id="projects">
        <section id="oeffigo" class="oeffigo-band" aria-labelledby="oeffigo-title">
          <div class="section-shell">
            <div class="section-head"><span class="section-num">01</span><h2>{content.oeffigo.eyebrow}</h2></div>
            <div class="featured-product featured-product--phone">
              <div class="featured-product-copy">
                <div class="product-heading"><img src={oeffigo.icon} alt="" width="64" height="64" loading="lazy" /><h2 id="oeffigo-title">ÖffiGo</h2></div>
                <p class="product-tagline">{oeffigo.tagline[lang]}</p>
                <p>{isDe ? "ÖffiGo ist mein größtes Projekt: eine Öffi-App für Österreich. Sie zeigt Abfahrten, findet Verbindungen und begleitet dich am iPhone und an der Apple Watch. An jeder Zeit steht, ob sie vom Betreiber kommt, berechnet ist oder nur im Fahrplan steht." : "ÖffiGo is my largest project: a public transport app for Austria. It shows departures, plans journeys and follows your trip on iPhone and Apple Watch. Each time tells you whether it comes from the operator, is calculated or is just the timetable."}</p>
                <p class="product-availability">{oeffigo.status[lang]}</p>
                <div class="oeffigo-actions"><a class="button primary" href={`${localePrefix}/oeffigo/`}>{content.oeffigo.detailCta}</a><a class="button secondary" href={oeffigo.websiteUrl}>oeffigo.app ↗</a></div>
                <p class="product-footnote"><a href={oeffigo.liveUrl}>{isDe ? "Pünktlichkeit nachschauen" : "Explore punctuality"} ↗</a><a href={oeffigo.statusUrl}>{isDe ? "Systemstatus" : "System status"} ↗</a></p>
              </div>
              <figure class="product-phone-preview"><img src={oeffigo.shots[0].src} alt={oeffigo.shots[0].alt[lang]} width="675" height="1380" loading="lazy" decoding="async" /><figcaption>{isDe ? "Die Heute-Ansicht am iPhone. Screenshot aus der Beta." : "Today on iPhone. Screenshot from the beta."}</figcaption></figure>
            </div>
          </div>
        </section>
        <section id="kontobuch" class="band section-shell" aria-labelledby="kontobuch-title">
          <div class="section-head"><span class="section-num">02</span><h2>{isDe ? "Für die Schule" : "For school"}</h2></div>
          <div class="featured-product featured-product--notebook">
            <div class="featured-product-copy">
              <div class="product-heading"><img src={kontobuch.icon} alt="" width="64" height="64" loading="lazy" /><h2 id="kontobuch-title">Kontobuch</h2></div>
              <p class="product-tagline">{isDe ? "Rechnungswesen, wie im Heft." : "Accounting, like a notebook."}</p>
              <p>{kontobuch.description[lang]}</p>
              <p>{isDe ? "Gebaut für HAK und HTL. Du kannst direkt im Browser anfangen oder die App installieren. Deine Hefte bleiben bei dir." : "Built for HAK and HTL students. Start in your browser or install the app. Your notebooks stay with you."}</p>
              <p class="product-availability">{kontobuch.availability[lang]}</p>
              <div class="oeffigo-actions"><a class="button primary" href={kontobuch.websiteUrl}>{kontobuch.websiteLabel[lang]} ↗</a></div>
            </div>
            <figure class="product-notebook-preview"><a href={kontobuch.websiteUrl} aria-label={isDe ? "Kontobuch ansehen" : "Explore Kontobuch"}><img src="/projects/kontobuch/notebook.jpg" alt={isDe ? "Kontobuch im Browser mit Heftseite, Beispielgeschäftsfall und Werkzeugen für T-Konten." : "Kontobuch in the browser, with a notebook page, an example transaction and T-account tools."} width="1280" height="850" loading="lazy" decoding="async" /></a><figcaption>{isDe ? "Eine Heftseite in der Web-App. Auf der Website kannst du selbst ausprobieren." : "A notebook page in the web app. Try it yourself on the website."}</figcaption></figure>
          </div>
        </section>
        <section class="band section-shell" aria-labelledby="selected-projects-title">
          <div class="section-head"><span class="section-num">03</span><h2 id="selected-projects-title">{isDe ? "Weitere Arbeiten" : "More of my work"}</h2></div>
          <div class="selected-work-grid">{selectedProjects.map(project => <ProjectPreview project={project} lang={lang} />)}</div>
          <ul class="small-work-list">{smallerProjects.map(project => <li><a href={`${localePrefix}/projects/${project.slug}/`}><div><h3>{project.name} <span aria-hidden="true">↗</span></h3><p>{getProjectCopy(project, lang).tagline}</p></div><span class={`status ${statusClass(project.status)}`}>{localizedStatusLabel(project.status, lang)}</span></a></li>)}</ul>
          <div class="catalogue-cta"><p>{isDe ? "Kleine Tools, Experimente und ältere Projekte findest du im Katalog." : "The smaller tools, experiments and older projects are in the catalogue."}</p><a class="button secondary" href={`${localePrefix}/projects/`}>{isDe ? "Alle Projekte" : "All projects"} <span aria-hidden="true">↗</span></a></div>
        </section>
      </div>

      {/* Services and the stack used to be two full bands, roughly two screens
          between the project index and the about line. They answer the same
          question — what this person can be handed — so they share one band.
          Both legacy anchors still resolve: #services is the band, #skills the
          stack strip inside it. */}
      <section id="services" class="band band--tint" aria-labelledby="services-title">
        <div class="section-shell">
          <div class="section-head">
            <span class="section-num">04</span>
            <h2 id="services-title">{content.services.title}</h2>
          </div>
          <p class="services-lead">{content.services.lead}</p>
          <div class="column-grid">
            {
              content.services.items.map((service) => (
                <article class="service-item">
                  <h3>{service.title}</h3>
                  <p>{service.body}</p>
                </article>
              ))
            }
          </div>

          <div id="skills" class="stack-strip">
            <p class="eyebrow">{content.skills.title}</p>
            <dl>
              {
                content.skills.groups.map((group) => (
                  <div>
                    <dt>{group.title}</dt>
                    <dd>{group.items.join(" · ")}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </section>

      <section id="about" class="band section-shell split-section" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">{content.about.eyebrow}</p>
          <h2 id="about-title">{content.about.title}</h2>
        </div>
        <p>{content.about.body}</p>
      </section>

      <section id="faq" class="band section-shell" aria-labelledby="faq-title">
        <div class="section-head">
          <span class="section-num">05</span>
          <h2 id="faq-title">{content.faq.title}</h2>
        </div>
        <div class="faq-list">
          {
            content.faq.items.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <div class="faq-answer">
                  <div>
                    <p>{item.a}</p>
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <section id="contact" class="band section-shell contact-section" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow">{content.contact.eyebrow}</p>
          <h2 id="contact-title">{content.contact.title}</h2>
          <p class="contact-note">{content.contact.note}</p>
          <p class="contact-note">
            <a class="text-link" href="mailto:contact@johannesgrof.me">contact@johannesgrof.me</a>
          </p>
          <SocialLinks />
        </div>

        <ContactForm content={content.contact.form} lang={isDe ? "de" : "en"} />
      </section>
    </main>

    <SiteFooter lang={isDe ? "de" : "en"} />

    <SpeedInsights />
  </body>
</html>

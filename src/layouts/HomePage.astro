---
import BaseHead from "@/components/BaseHead.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import {
  featuredShowcaseProjects,
  getProjectCopy,
  localizedStatusLabel,
  projectSections,
  publicProjects,
  statusClass,
  upcomingProjects,
} from "@/data/projects";
import type { Project, ProjectLang, ProjectStatus } from "@/data/projects";
import { getProjectGitHubInfo } from "@/data/github";
import { oeffigo } from "@/data/oeffigo";
import type { LocaleContent } from "@/data/siteContent";
import { toCanonicalUrl } from "@/data/siteMetadata";
import "@/styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  content: LocaleContent;
  canonicalPath: string;
}

const { content, canonicalPath } = Astro.props;
const isDe = content.lang !== "en";
const lang: ProjectLang = isDe ? "de" : "en";
const localePrefix = isDe ? "/de" : "";

// Build-time live GitHub data for the index rows (version, stars, downloads).
// Falls back gracefully when the API is unavailable.
const githubInfoBySlug = new Map(
  await Promise.all(publicProjects.map(async (project) => [project.slug, await getProjectGitHubInfo(project)] as const))
);

const compactCount = (value: number) =>
  value >= 1000 ? `${(value / 1000).toFixed(value >= 10000 ? 0 : 1).replace(/\.0$/, "")}k` : String(value);

// Normalize a version-ish string to a "vX.Y.Z" chip, or null if it isn't one —
// status words like "unreleased" must never render as "vunreleased".
const versionChip = (value?: string) => {
  if (!value || !/\d/.test(value)) {
    return null;
  }

  return /^v/i.test(value) ? value : `v${value}`;
};

const liveStats = (slug: string) => {
  const info = githubInfoBySlug.get(slug);

  if (!info) {
    return [];
  }

  const stats: string[] = [];
  const version = versionChip(info.version);

  if (version) {
    stats.push(version);
  }

  if (info.stars > 0) {
    stats.push(`★ ${info.stars}`);
  }

  if (info.downloads > 0) {
    stats.push(`↓ ${compactCount(info.downloads)}`);
  }

  return stats;
};

interface IndexRow {
  num: string;
  name: string;
  href?: string;
  description: string;
  stack: string[];
  status: ProjectStatus;
  stats: string[];
}

const projectRow = (project: Project): Omit<IndexRow, "num"> => ({
  name: project.name,
  href: `${localePrefix}/projects/${project.slug}/`,
  description: getProjectCopy(project, lang).tagline,
  stack: project.stack,
  status: project.status,
  stats: liveStats(project.slug),
});

// ÖffiGo deliberately has no index row: its own band sits directly above this
// section, so listing it again would name the same project three times inside
// one screen.
const rawGroups: { title: string; rows: Omit<IndexRow, "num">[] }[] = [
  {
    title: content.projects.highlights,
    rows: featuredShowcaseProjects.map(projectRow),
  },
  ...projectSections.map((section, sectionIndex) => ({
    title: isDe ? section.de.title : section.title,
    rows: [
      ...section.projects.map(projectRow),
      // A single unreleased project does not deserve a section of its own, so
      // it rides along at the end of the last group with its own status.
      ...(sectionIndex === projectSections.length - 1
        ? upcomingProjects.map((project) => ({
            name: project.name,
            description: isDe && project.de ? project.de.description : project.description,
            stack: project.stack,
            status: project.status,
            stats: [] as string[],
          }))
        : []),
    ],
  })),
];

// One continuous run of numbers across every group, so the index reads as a
// single catalogue rather than as separate widgets.
let runningNumber = 0;
const indexGroups = rawGroups.map((group) => ({
  title: group.title,
  rows: group.rows.map((row) => ({ ...row, num: String(++runningNumber).padStart(2, "0") })),
}));

const shippedProjectCount = publicProjects.filter((project) => project.visibility === "public").length;

// Split the headline around its accent word here rather than in the template:
// interpolating three expressions across separate JSX lines re-introduces the
// whitespace that would show up as a gap before the following punctuation.
const accentWord = content.hero.titleAccent;
const accentAt = accentWord ? content.hero.title.indexOf(accentWord) : -1;
const titleLead = accentAt >= 0 ? content.hero.title.slice(0, accentAt) : content.hero.title;
const titleAccent = accentAt >= 0 && accentWord ? accentWord : "";
const titleTail = accentAt >= 0 && accentWord ? content.hero.title.slice(accentAt + accentWord.length) : "";

const hreflangAlternates = [
  { hreflang: "en", href: toCanonicalUrl("/") },
  { hreflang: "de-AT", href: toCanonicalUrl("/de/") },
  { hreflang: "x-default", href: toCanonicalUrl("/") },
];

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "Johannes Grof",
  url: toCanonicalUrl(canonicalPath),
  inLanguage: content.lang,
  description: content.meta.description,
  mainEntity: {
    "@type": "Person",
    name: "Johannes Grof",
    jobTitle: "Software Developer (Student)",
    description: content.meta.description,
    nationality: "Austrian",
    address: {
      "@type": "PostalAddress",
      addressRegion: "Styria",
      addressCountry: "AT",
    },
    url: toCanonicalUrl("/"),
    email: "contact@johannesgrof.me",
    sameAs: ["https://github.com/jx-grxf", "https://www.linkedin.com/in/johannes-grof", "https://x.com/jx_grxf"],
    affiliation: {
      "@type": "EducationalOrganization",
      name: "HTL Kaindorf",
      url: "https://www.htl-kaindorf.at/",
    },
    knowsAbout: ["TypeScript", "Swift", "Python", "Astro", "macOS apps", "developer tools", "web development", "web hosting", "domain management", "website maintenance", "electronics repair", "technical support"],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: content.lang,
  mainEntity: content.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <BaseHead
      title={content.meta.title}
      description={content.meta.description}
      canonicalPath={canonicalPath}
      ogLocale={content.ogLocale}
      hreflangAlternates={hreflangAlternates}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profileSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#projects">{isDe ? "Zum Inhalt springen" : "Skip to content"}</a>
    <SiteHeader navItems={content.nav} homeHref={canonicalPath} langSwitch={content.langSwitch} />

    <main>
      <section class="hero section-shell" aria-labelledby="hero-title">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title" data-typewriter><span class="type-text">{titleLead}<span class="display-em">{titleAccent}</span>{titleTail}</span><span class="cursor" aria-hidden="true"></span></h1>
        <p class="hero-text">{content.hero.body}</p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">{content.hero.primaryAction}</a>
          <a class="button secondary" href="#contact">{content.hero.contactAction}</a>
        </div>
        <ul class="hero-facts">
          <li><strong>{shippedProjectCount}</strong> {content.hero.factsCountLabel}</li>
          {content.hero.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </section>

      <section id="oeffigo" class="oeffigo-band" aria-labelledby="oeffigo-title">
        <div class="section-shell">
          <div class="section-head">
            <span class="section-num">01</span>
            <h2>{content.oeffigo.eyebrow}</h2>
          </div>
          <div class="oeffigo-layout">
            <div>
              <div class="oeffigo-headline">
                <img class="oeffigo-icon" src={oeffigo.icon} alt="ÖffiGo app icon" width="120" height="120" loading="lazy" decoding="async" />
                <div>
                  <h2 id="oeffigo-title">{oeffigo.name}</h2>
                  <p class="oeffigo-tagline">{oeffigo.tagline[lang]}</p>
                </div>
              </div>
              <p class="oeffigo-lead">{oeffigo.lead[lang]}</p>
              <ul class="oeffigo-meta">
                <li>{oeffigo.platform[lang]}</li>
                <li>{oeffigo.status[lang]}</li>
              </ul>
              <div class="oeffigo-actions">
                <a class="button primary" href={`${localePrefix}/oeffigo/`}>{content.oeffigo.detailCta}</a>
                <a class="button secondary" href={oeffigo.websiteUrl} rel="me">oeffigo.app</a>
              </div>

              <div class="note-block">
                <p class="eyebrow">{oeffigo.liveProof.eyebrow[lang]}</p>
                <h3>{oeffigo.liveProof.title[lang]}</h3>
                <p>{oeffigo.liveProof.body[lang]}</p>
                <div class="note-actions">
                  <a href={oeffigo.liveUrl} rel="me">{oeffigo.liveProof.liveLabel[lang]}</a>
                  <a href={oeffigo.statusUrl} rel="me">{oeffigo.liveProof.statusLabel[lang]}</a>
                </div>
              </div>
            </div>

            <ul class="oeffigo-features">
              {
                oeffigo.features.slice(0, 4).map((feature) => (
                  <li class="oeffigo-feature">
                    <span class="oeffigo-feature-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={feature.icon} /></svg>
                    </span>
                    <h3>{feature.title[lang]}</h3>
                    <p>{feature.body[lang]}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section id="projects" class="band section-shell" aria-labelledby="projects-title">
        <div class="section-head">
          <span class="section-num">02</span>
          <h2 id="projects-title">{content.projects.title}</h2>
        </div>

        {
          indexGroups.map((group) => (
            <div class="index-group">
              <p class="eyebrow">{group.title}</p>
              <ol class="index-list">
                {group.rows.map((row) => {
                  const inner = (
                    <Fragment>
                      <span class="index-num">{row.num}</span>
                      <h3>{row.name}</h3>
                      <p class="index-desc">{row.description}</p>
                      <span class="index-stack">{row.stack.join(" · ")}</span>
                      <span class="index-meta">
                        <span class={`status ${statusClass(row.status)}`}>{localizedStatusLabel(row.status, lang)}</span>
                        {row.stats.length > 0 && (
                          <ul class="index-stats">
                            {row.stats.map((stat) => <li>{stat}</li>)}
                          </ul>
                        )}
                      </span>
                    </Fragment>
                  );

                  return (
                    <li>
                      {row.href ? (
                        <a class="index-row" href={row.href}>{inner}</a>
                      ) : (
                        <div class="index-row index-row--muted">{inner}</div>
                      )}
                    </li>
                  );
                })}
              </ol>
            </div>
          ))
        }
      </section>

      <section id="skills" class="band section-shell" aria-labelledby="skills-title">
        <div class="section-head">
          <span class="section-num">03</span>
          <h2 id="skills-title">{content.skills.title}</h2>
        </div>
        <div class="column-grid">
          {
            content.skills.groups.map((group) => (
              <article class="skill-group">
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="services" class="band band--tint" aria-labelledby="services-title">
        <div class="section-shell">
          <div class="section-head">
            <span class="section-num">04</span>
            <h2 id="services-title">{content.services.title}</h2>
          </div>
          <p class="services-lead">{content.services.lead}</p>
          <div class="column-grid">
            {
              content.services.items.map((service) => (
                <article class="service-item">
                  <h3>{service.title}</h3>
                  <p>{service.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="about" class="band section-shell split-section" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">{content.about.eyebrow}</p>
          <h2 id="about-title">{content.about.title}</h2>
        </div>
        <p>{content.about.body}</p>
      </section>

      <section id="faq" class="band section-shell" aria-labelledby="faq-title">
        <div class="section-head">
          <span class="section-num">05</span>
          <h2 id="faq-title">{content.faq.title}</h2>
        </div>
        <div class="faq-list">
          {
            content.faq.items.map((item) => (
              <details class="faq-item">
                <summary aria-expanded="false">{item.q}</summary>
                <div class="faq-answer">
                  <div>
                    <p>{item.a}</p>
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <section id="contact" class="band section-shell contact-section" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow">{content.contact.eyebrow}</p>
          <h2 id="contact-title">{content.contact.title}</h2>
          <p class="contact-note">{content.contact.note}</p>
          <p class="contact-note">
            <a class="text-link" href="mailto:contact@johannesgrof.me">contact@johannesgrof.me</a>
          </p>
          <SocialLinks />
        </div>

        <form class="contact-form" id="contact-form" novalidate>
          <div class="contact-field">
            <label for="contact-name">{content.contact.form.nameLabel}</label>
            <input type="text" id="contact-name" name="name" autocomplete="name" maxlength="120" placeholder={content.contact.form.namePlaceholder} required />
          </div>
          <div class="contact-field">
            <label for="contact-email">{content.contact.form.emailLabel}</label>
            <input type="email" id="contact-email" name="email" autocomplete="email" maxlength="320" placeholder={content.contact.form.emailPlaceholder} required />
          </div>
          <div class="contact-field">
            <label for="contact-message">{content.contact.form.messageLabel}</label>
            <textarea id="contact-message" name="message" rows="4" maxlength="5000" placeholder={content.contact.form.messagePlaceholder} required></textarea>
          </div>
          <input type="text" name="company" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="contact-submit" data-label={content.contact.form.submit} data-sending={content.contact.form.sending}>{content.contact.form.submit}</button>
          <p class="contact-status" role="status" aria-live="polite" data-success={content.contact.form.success} data-error={content.contact.form.error} data-rate-limited={content.contact.form.rateLimited}></p>
          <p class="contact-privacy-note">
            {isDe ? "Mit dem Absenden stimmen Sie der " : "By sending you agree to the "}
            <a href="/datenschutz/">{isDe ? "Datenschutzerklärung" : "privacy policy"}</a>{isDe ? " zu." : "."}
          </p>
        </form>
      </section>
    </main>

    <SiteFooter lang={isDe ? "de" : "en"} />

    <script>
      // Type the headline out on arrival. The full text is server-rendered, so
      // search engines and screen readers get it either way — this only clears
      // and refills the existing nodes, keeping the accent span intact.
      const headline = document.querySelector<HTMLElement>("[data-typewriter]");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (headline && !prefersReducedMotion) {
        const target = headline.querySelector<HTMLElement>(".type-text");
        const segments = target
          ? Array.from(target.childNodes)
              .map((node) => ({ node, text: node.textContent ?? "" }))
              .filter((segment) => segment.text.length > 0)
          : [];

        const run = () => {
          // Lock in the finished height first, otherwise every new line pushes
          // the rest of the page down while the text arrives.
          headline.style.minHeight = `${headline.offsetHeight}px`;
          headline.classList.add("is-typing");
          segments.forEach((segment) => {
            segment.node.textContent = "";
          });

          let segmentIndex = 0;
          let charIndex = 0;

          const step = () => {
            const segment = segments[segmentIndex];

            if (!segment) {
              headline.classList.remove("is-typing");
              headline.style.minHeight = "";
              return;
            }

            charIndex += 1;
            segment.node.textContent = segment.text.slice(0, charIndex);

            const justTyped = segment.text[charIndex - 1];

            if (charIndex >= segment.text.length) {
              segmentIndex += 1;
              charIndex = 0;
            }

            // Punctuation gets a beat, the way a person typing would pause.
            window.setTimeout(step, justTyped === "," || justTyped === "." ? 260 : 52);
          };

          step();
        };

        if (segments.length > 0) {
          // Measure only once the display face is in: locking the height against
          // fallback metrics would leave the headline a line short or long.
          if (document.fonts?.ready) {
            document.fonts.ready.then(run);
          } else {
            run();
          }
        }
      }

      // Async contact-form submission so the page never reloads.
      const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
      if (contactForm) {
        const submitButton = contactForm.querySelector<HTMLButtonElement>(".contact-submit");
        const status = contactForm.querySelector<HTMLParagraphElement>(".contact-status");

        contactForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!submitButton || !status) {
            return;
          }
          if (!contactForm.reportValidity()) {
            return;
          }

          submitButton.disabled = true;
          submitButton.textContent = submitButton.dataset.sending ?? "Sending…";
          status.textContent = "";
          status.classList.remove("is-error", "is-success");

          try {
            const payload = Object.fromEntries(new FormData(contactForm).entries());
            const response = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });

            if (response.status === 429) {
              status.textContent = status.dataset.rateLimited ?? "Too many requests. Please wait a few minutes.";
              status.classList.add("is-error");
              return;
            }
            if (!response.ok) {
              throw new Error(`Request failed: ${response.status}`);
            }

            contactForm.reset();
            status.textContent = status.dataset.success ?? "Sent.";
            status.classList.add("is-success");
          } catch {
            status.textContent = status.dataset.error ?? "Something went wrong.";
            status.classList.add("is-error");
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = submitButton.dataset.label ?? "Send message";
          }
        });
      }

      // Keep the details content mounted until the closing transition finishes.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((details) => {
        const summary = details.querySelector("summary");
        const answer = details.querySelector<HTMLElement>(".faq-answer");
        if (!summary || !answer) {
          return;
        }

        let closeTimer: number | undefined;
        let removeCloseListener: (() => void) | undefined;

        const cancelPendingClose = () => {
          window.clearTimeout(closeTimer);
          removeCloseListener?.();
          removeCloseListener = undefined;
        };

        const close = () => {
          details.classList.remove("is-open");
          summary.setAttribute("aria-expanded", "false");

          const finish = () => {
            cancelPendingClose();
            details.open = false;
          };
          const onTransitionEnd = (event: TransitionEvent) => {
            if (event.target === answer && event.propertyName === "grid-template-rows") {
              finish();
            }
          };

          answer.addEventListener("transitionend", onTransitionEnd);
          removeCloseListener = () => answer.removeEventListener("transitionend", onTransitionEnd);
          closeTimer = window.setTimeout(finish, 400);
        };

        const open = () => {
          cancelPendingClose();
          details.open = true;
          summary.setAttribute("aria-expanded", "true");
          window.requestAnimationFrame(() => details.classList.add("is-open"));
        };

        summary.addEventListener("click", (event) => {
          event.preventDefault();

          if (reduceMotion) {
            details.open = !details.open;
            details.classList.toggle("is-open", details.open);
            summary.setAttribute("aria-expanded", String(details.open));
            return;
          }

          if (details.classList.contains("is-open")) {
            close();
          } else {
            open();
          }
        });
      });
    </script>
    <SpeedInsights />
  </body>
</html>

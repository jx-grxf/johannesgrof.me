{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "johannesgrof.com"
        }
      ],
      "destination": "https://johannesgrof.me/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.johannesgrof.com"
        }
      ],
      "destination": "https://johannesgrof.me/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.johannesgrof.me"
        }
      ],
      "destination": "https://johannesgrof.me/:path*",
      "permanent": true
    },
    {
      "source": "/projects/digi2pdf",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/de/projects/digi2pdf",
      "destination": "/de/#projects",
      "permanent": true
    },
    {
      "source": "/projects/digi2pdf/",
      "destination": "/#projects",
      "permanent": true
    },
    {
      "source": "/de/projects/digi2pdf/",
      "destination": "/de/#projects",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.github.com https://vitals.vercel-insights.com; frame-ancestors 'none'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://vercel.live https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/projects/(.*)\\.(webp|png|jpg|jpeg|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og-card(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|humans\\.txt|llms\\.txt|llms-full\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}

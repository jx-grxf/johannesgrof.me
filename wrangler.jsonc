// Cloudflare Workers config, used only with DEPLOY_TARGET=cloudflare.
// Custom domains are attached in the dashboard, not here, so a deploy never moves
// johannesgrof.me between hosts by itself. Switching is described in
// Brain/10_Architektur/Hosting — Vercel und Cloudflare umschaltbar.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "johannesgrof-me",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // Hashed build files come straight from the asset store (immutable via _headers);
    // everything else passes the Worker for the vercel.json redirects and headers.
    // The account is on the free plan, where every Worker invocation counts.
    "run_worker_first": ["/*", "!/_astro/*"]
  },
  "observability": { "enabled": true }
}
